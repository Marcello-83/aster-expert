# PONTONS-ALU-01 : une travée de panne (passerelle d'accès sur pieux) en aluminium
# soudé, calcul PRO (lot 50). Code_Aster 17.4. Unités : m, N, Pa, °C.
# Maillage : maillage_pontons.med, produit par maillage_pontons.py (paramètres en tête).
# Généré par pontons_alu_01.generation à partir de la fiche (décisions P1 à P28 de
# MM), des données (donnees/pontons_alu_01_model_data.yaml) et des paramètres du
# script de maillage : régénérer plutôt qu'éditer (aster-expert projet pontons_alu_01
# generer). Cas élémentaires seulement ; combinaisons et livrables : post-traitement.
#
# Paramètres (rappel)
#   L = 6.25 m (P1), B = 1.86 m, tablier 2.0 m (P24), plan moyen +1.358 NGF, pannes +1.458 (P7, P21)
#   aluminium E = 7e+10 Pa, ν = 0.3, α = 2.3e-05 /°C, γ = 27000 N/m³ (D3)
#   béton E = 3.4e+10 Pa, ν = 0.2, γ = 25000 N/m³ (P20, D4)
#   sol kn = 5e+06 N/m³, kt = 1e+06 N/m³ sous 3.6540 m² (P19)
#   G2 = 1000 Pa, Q = 5000 Pa, houle unitaire 1000 Pa, amarrage 8000 N,
#   accostage 16000 / 77000 N/m (P8, P9, P13, D4)
#   ΔT : T+ +46, T− -28 (jeu B), TA+ +56, TA− -23 (jeu A) °C (P10)

DEBUT(CODE="OUI")

# ---------------------------------------------------------------- 1. MAILLAGE
MAIL0 = LIRE_MAILLAGE(FORMAT="MED", UNITE=20)
# Appui élastique réparti (P19) : une maille POI1 par nœud de la semelle (ssls135a).
MAIL = CREA_MAILLAGE(MAILLAGE=MAIL0, CREA_POI1=_F(NOM_GROUP_MA="SOL", GROUP_MA="SEMELLE"))
MAIL = DEFI_GROUP(reuse=MAIL, MAILLAGE=MAIL, CREA_GROUP_NO=_F(GROUP_MA="SEMELLE", NOM="N_SEMELLE"))

# ---------------------------------------------------------------- 2. MODÈLE
# Barres : poutres de Timoshenko 3D (POU_D_T) ; semelle : DKT ; sol : DIS_T.
MODELE = AFFE_MODELE(
    MAILLAGE=MAIL,
    AFFE=(
        _F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS", "CHEVETRE", "POTEAUX"), PHENOMENE="MECANIQUE", MODELISATION="POU_D_T"),
        _F(GROUP_MA="SEMELLE", PHENOMENE="MECANIQUE", MODELISATION="DKT"),
        _F(GROUP_MA="SOL", PHENOMENE="MECANIQUE", MODELISATION="DIS_T"),
    ),
)

# ---------------------------------------------------------------- 3. MATÉRIAUX
# RHO = γ / g (CA-048). Températures : aluminium seulement (P10).
ALU = DEFI_MATERIAU(ELAS=_F(E=70000000000.0, NU=0.3, RHO=2752.293577981651, ALPHA=2.3e-05))
BETON = DEFI_MATERIAU(ELAS=_F(E=34000000000.0, NU=0.2, RHO=2548.41997961264))
CHMAT = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS"), MATER=ALU), _F(GROUP_MA=("CHEVETRE", "POTEAUX", "SEMELLE"), MATER=BETON)),
)

# ---------------------------------------------------------------- 4. CARACTÉRISTIQUES
# Poutres principales MP1200 (P4, D3) : IY = inertie forte (y_l horizontal), AZ = A/Avz ;
# Avy non donné : AY = AZ (hypothèse provisoire, à confirmer par MM).
# Tubes carrés à angles vifs (D3) : A, I et JX (Bredt) calculés par Code_Aster (U4.42.01).
# Repère local : z_l = +Z pour les barres horizontales (VECT_Z), y_l = +X pour les verticales.
CARA = AFFE_CARA_ELEM(
    MODELE=MODELE,
    POUTRE=(
        _F(GROUP_MA="POUTRES_PRINC", SECTION="GENERALE", CARA=("A", "IY", "IZ", "JX", "AY", "AZ"), VALE=(0.0044399999999999995, 2.5641511e-05, 1.0209212e-05, 1.207e-05, 2.5502584721424464, 2.5502584721424464)),
        _F(GROUP_MA=("MONTANTS", "DIAGONALES", "SUPPORTS"), SECTION="RECTANGLE", CARA=("H", "EP"), VALE=(0.15, 0.007)),
        _F(GROUP_MA="PANNES_SEC", SECTION="RECTANGLE", CARA=("H", "EP"), VALE=(0.05, 0.005)),
        _F(GROUP_MA="CHEVETRE", SECTION="RECTANGLE", CARA=("HY", "HZ"), VALE=(0.25, 0.4)),
        _F(GROUP_MA="POTEAUX", SECTION="CERCLE", CARA=("R",), VALE=(0.25,)),
    ),
    ORIENTATION=(
        _F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "CHEVETRE"), CARA="VECT_Z", VALE=(0.0, 0.0, 1.0)),
        _F(GROUP_MA=("SUPPORTS", "POTEAUX"), CARA="VECT_Y", VALE=(1.0, 0.0, 0.0)),
    ),
    COQUE=_F(GROUP_MA="SEMELLE", EPAIS=0.25, ANGL_REP=(0.0, 0.0)),
    DISCRET=_F(GROUP_MA="SOL", CARA="M_T_D_N", VALE=0.0),
    # P19 : raideurs globales k × surface, réparties au prorata des surfaces (U4.42.01).
    RIGI_PARASOL=_F(
        GROUP_MA="SEMELLE", GROUP_MA_POI1="SOL", COEF_GROUP=1.0, CARA="K_T_D_N",
        VALE=(3653999.9999999995, 3653999.9999999995, 18269999.999999996),
        COOR_CENTRE=(6.38, 0.0, -0.755),
    ),
)

# ---------------------------------------------------------------- 5. LIAISONS ET APPUIS
# P25 : rotule côté quai Y > 0 fixe (translations bloquées), rotule Y < 0 guidée (libre
# en Y). P6, P7, P18 : liaisons rigides
# LIAISON_SOLIDE (U4.44.01) panne / montant ou diagonale (LR_01 à LR_44), tête de profilé
# support / tablier, tête de poteau / axe du chevêtre, pied de poteau / plan moyen de la
# semelle. P18 : pied de profilé support articulé sur le chevêtre, bras rigide de
# l'axe du chevêtre au dessus du chevêtre : u_S = u_C + θ_C ∧ (0, 0, h) (LIAISON_DDL).
CL = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=(_F(GROUP_NO="APP_QUAI_YP", DX=0.0, DY=0.0, DZ=0.0), _F(GROUP_NO="APP_QUAI_YM", DX=0.0, DZ=0.0)),
    LIAISON_SOLIDE=(
        _F(GROUP_NO="LR_01"), _F(GROUP_NO="LR_02"), _F(GROUP_NO="LR_03"), _F(GROUP_NO="LR_04"), _F(GROUP_NO="LR_05"), _F(GROUP_NO="LR_06"),
        _F(GROUP_NO="LR_07"), _F(GROUP_NO="LR_08"), _F(GROUP_NO="LR_09"), _F(GROUP_NO="LR_10"), _F(GROUP_NO="LR_11"), _F(GROUP_NO="LR_12"),
        _F(GROUP_NO="LR_13"), _F(GROUP_NO="LR_14"), _F(GROUP_NO="LR_15"), _F(GROUP_NO="LR_16"), _F(GROUP_NO="LR_17"), _F(GROUP_NO="LR_18"),
        _F(GROUP_NO="LR_19"), _F(GROUP_NO="LR_20"), _F(GROUP_NO="LR_21"), _F(GROUP_NO="LR_22"), _F(GROUP_NO="LR_23"), _F(GROUP_NO="LR_24"),
        _F(GROUP_NO="LR_25"), _F(GROUP_NO="LR_26"), _F(GROUP_NO="LR_27"), _F(GROUP_NO="LR_28"), _F(GROUP_NO="LR_29"), _F(GROUP_NO="LR_30"),
        _F(GROUP_NO="LR_31"), _F(GROUP_NO="LR_32"), _F(GROUP_NO="LR_33"), _F(GROUP_NO="LR_34"), _F(GROUP_NO="LR_35"), _F(GROUP_NO="LR_36"),
        _F(GROUP_NO="LR_37"), _F(GROUP_NO="LR_38"), _F(GROUP_NO="LR_39"), _F(GROUP_NO="LR_40"), _F(GROUP_NO="LR_41"), _F(GROUP_NO="LR_42"),
        _F(GROUP_NO="LR_43"), _F(GROUP_NO="LR_44"), _F(GROUP_NO="LR_45"), _F(GROUP_NO="LR_46"), _F(GROUP_NO="LR_47"), _F(GROUP_NO="LR_48"),
        _F(GROUP_NO="LR_49"), _F(GROUP_NO="LR_50"), _F(GROUP_NO="LR_51"),
    ),
    LIAISON_DDL=(
        _F(GROUP_NO=("ROT_S1", "ROT_C1", "ROT_C1"), DDL=("DX", "DX", "DRY"), COEF_MULT=(1.0, -1.0, -0.20000000000000007), COEF_IMPO=0.0),
        _F(GROUP_NO=("ROT_S1", "ROT_C1", "ROT_C1"), DDL=("DY", "DY", "DRX"), COEF_MULT=(1.0, -1.0, 0.20000000000000007), COEF_IMPO=0.0),
        _F(GROUP_NO=("ROT_S1", "ROT_C1"), DDL=("DZ", "DZ"), COEF_MULT=(1.0, -1.0), COEF_IMPO=0.0),
        _F(GROUP_NO=("ROT_S2", "ROT_C2", "ROT_C2"), DDL=("DX", "DX", "DRY"), COEF_MULT=(1.0, -1.0, -0.20000000000000007), COEF_IMPO=0.0),
        _F(GROUP_NO=("ROT_S2", "ROT_C2", "ROT_C2"), DDL=("DY", "DY", "DRX"), COEF_MULT=(1.0, -1.0, 0.20000000000000007), COEF_IMPO=0.0),
        _F(GROUP_NO=("ROT_S2", "ROT_C2"), DDL=("DZ", "DZ"), COEF_MULT=(1.0, -1.0), COEF_IMPO=0.0),
        _F(GROUP_NO=("ROT_S3", "ROT_C3", "ROT_C3"), DDL=("DX", "DX", "DRY"), COEF_MULT=(1.0, -1.0, -0.20000000000000007), COEF_IMPO=0.0),
        _F(GROUP_NO=("ROT_S3", "ROT_C3", "ROT_C3"), DDL=("DY", "DY", "DRX"), COEF_MULT=(1.0, -1.0, 0.20000000000000007), COEF_IMPO=0.0),
        _F(GROUP_NO=("ROT_S3", "ROT_C3"), DDL=("DZ", "DZ"), COEF_MULT=(1.0, -1.0), COEF_IMPO=0.0),
    ),
)

# ---------------------------------------------------------------- 6. CAS DE CHARGE
# D4. Actions de surface (P22) : FORCE_POUTRE sur les barres longitudinales, largeur
# d'influence b de chaque ligne, tablier de 2.0 m (P24, Σ b = 2.000 m), poids des défenses négligé.
CH_G1 = AFFE_CHAR_MECA(MODELE=MODELE, PESANTEUR=_F(GRAVITE=9.81, DIRECTION=(0.0, 0.0, -1.0)))
CH_G2 = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_POUTRE=(
    _F(GROUP_MA="PP_YM", FZ=-260.0),  # b = 0.260 m
    _F(GROUP_MA="PANNE_4", FZ=-375.0),  # b = 0.375 m
    _F(GROUP_MA="PANNE_3", FZ=-370.0),  # b = 0.370 m
    _F(GROUP_MA="PANNE_2", FZ=-370.0),  # b = 0.370 m
    _F(GROUP_MA="PANNE_1", FZ=-370.0000000000001),  # b = 0.370 m
    _F(GROUP_MA="PP_YP", FZ=-254.9999999999999),  # b = 0.255 m
))
CH_Q = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_POUTRE=(
    _F(GROUP_MA="PP_YM", FZ=-1300.0),  # b = 0.260 m
    _F(GROUP_MA="PANNE_4", FZ=-1875.0),  # b = 0.375 m
    _F(GROUP_MA="PANNE_3", FZ=-1850.0),  # b = 0.370 m
    _F(GROUP_MA="PANNE_2", FZ=-1850.0),  # b = 0.370 m
    _F(GROUP_MA="PANNE_1", FZ=-1850.0000000000005),  # b = 0.370 m
    _F(GROUP_MA="PP_YP", FZ=-1274.9999999999995),  # b = 0.255 m
))
CH_QD = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_POUTRE=(
    _F(GROUP_MA="PANNE_3", FZ=-25.00000000000002),  # b = 0.005 m
    _F(GROUP_MA="PANNE_2", FZ=-1850.0),  # b = 0.370 m
    _F(GROUP_MA="PANNE_1", FZ=-1850.0000000000005),  # b = 0.370 m
    _F(GROUP_MA="PP_YP", FZ=-1274.9999999999995),  # b = 0.255 m
))
CH_HU = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_POUTRE=(
    _F(GROUP_MA="PP_YM", FZ=260.0),  # b = 0.260 m
    _F(GROUP_MA="PANNE_4", FZ=375.0),  # b = 0.375 m
    _F(GROUP_MA="PANNE_3", FZ=370.0),  # b = 0.370 m
    _F(GROUP_MA="PANNE_2", FZ=370.0),  # b = 0.370 m
    _F(GROUP_MA="PANNE_1", FZ=370.0000000000001),  # b = 0.370 m
    _F(GROUP_MA="PP_YP", FZ=254.9999999999999),  # b = 0.255 m
))
CH_HD = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_POUTRE=(
    _F(GROUP_MA="PP_YM", FZ=-260.0),  # b = 0.260 m
    _F(GROUP_MA="PANNE_4", FZ=-375.0),  # b = 0.375 m
    _F(GROUP_MA="PANNE_3", FZ=-370.0),  # b = 0.370 m
    _F(GROUP_MA="PANNE_2", FZ=-370.0),  # b = 0.370 m
    _F(GROUP_MA="PANNE_1", FZ=-370.0000000000001),  # b = 0.370 m
    _F(GROUP_MA="PP_YP", FZ=-254.9999999999999),  # b = 0.255 m
))
# P13 : amarrage vers l'extérieur, accostage vers l'intérieur, sur une poutre principale.
CH_AMM = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_NODALE=_F(GROUP_NO="AMAR_YM", FY=-8000.0))
CH_AMP = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_NODALE=_F(GROUP_NO="AMAR_YP", FY=8000.0))
CH_ACM = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_POUTRE=_F(GROUP_MA="ACC_YM", FY=16000.0))
CH_ACP = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_POUTRE=_F(GROUP_MA="ACC_YP", FY=-16000.0))
CH_AAM = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_POUTRE=_F(GROUP_MA="ACC_YM", FY=77000.0))
CH_AAP = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_POUTRE=_F(GROUP_MA="ACC_YP", FY=-77000.0))

# ---------------------------------------------------------------- 7. RÉSOLUTION
# Cas mécaniques : une factorisation (MACRO_ELAS_MULT, CA-055).
ELEM = MACRO_ELAS_MULT(
    MODELE=MODELE,
    CHAM_MATER=CHMAT,
    CARA_ELEM=CARA,
    CHAR_MECA_GLOBAL=CL,
    CAS_CHARGE=(
        _F(NOM_CAS="G1", CHAR_MECA=CH_G1, OPTION="SANS"),  # poids propre (aluminium 27 kN/m³, béton armé 25 kN/m³)
        _F(NOM_CAS="G2", CHAR_MECA=CH_G2, OPTION="SANS"),  # G2 = 1,0 kN/m² sur tout le tablier (P8, P22, P24)
        _F(NOM_CAS="Q", CHAR_MECA=CH_Q, OPTION="SANS"),  # Q = 5 kPa sur tout le tablier
        _F(NOM_CAS="QD", CHAR_MECA=CH_QD, OPTION="SANS"),  # Q½ = 5 kPa sur la moitié Y > 0
        _F(NOM_CAS="HU", CHAR_MECA=CH_HU, OPTION="SANS"),  # houle, 1 kPa vers le haut
        _F(NOM_CAS="HD", CHAR_MECA=CH_HD, OPTION="SANS"),  # houle, 1 kPa vers le bas
        _F(NOM_CAS="AMM", CHAR_MECA=CH_AMM, OPTION="SANS"),  # amarrage 2 × 8 kN, poutre de rive Y < 0, vers −Y
        _F(NOM_CAS="AMP", CHAR_MECA=CH_AMP, OPTION="SANS"),  # amarrage 2 × 8 kN, poutre de rive Y > 0, vers +Y
        _F(NOM_CAS="ACM", CHAR_MECA=CH_ACM, OPTION="SANS"),  # accostage 16 kN/m, poutre de rive Y < 0, vers +Y
        _F(NOM_CAS="ACP", CHAR_MECA=CH_ACP, OPTION="SANS"),  # accostage 16 kN/m, poutre de rive Y > 0, vers −Y
        _F(NOM_CAS="AAM", CHAR_MECA=CH_AAM, OPTION="SANS"),  # accostage accidentel 77 kN/m, poutre de rive Y < 0, vers +Y
        _F(NOM_CAS="AAP", CHAR_MECA=CH_AAP, OPTION="SANS"),  # accostage accidentel 77 kN/m, poutre de rive Y > 0, vers −Y
    ),
    SOLVEUR=_F(METHODE="MUMPS", POSTTRAITEMENTS="FORCE"),
)
ELEM = CALC_CHAMP(reuse=ELEM, RESULTAT=ELEM, GROUP_MA="SEMELLE", CONTRAINTE=("EFGE_NOEU",))
ELEM = CALC_CHAMP(reuse=ELEM, RESULTAT=ELEM, GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS", "CHEVETRE", "POTEAUX"), CONTRAINTE=("EFGE_ELNO",))
ELEM = CALC_CHAMP(reuse=ELEM, RESULTAT=ELEM, FORCE=("REAC_NODA",))
# Températures uniformes (P10), CA-054 : un champ de matériau par cas.
# T+ = +46 °C, tout l'aluminium (jeu B)
T_TP = CREA_CHAMP(OPERATION="AFFE", TYPE_CHAM="NOEU_TEMP_R", MAILLAGE=MAIL, AFFE=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS"), NOM_CMP="TEMP", VALE=46.0))
M_TP = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS"), MATER=ALU), _F(GROUP_MA=("CHEVETRE", "POTEAUX", "SEMELLE"), MATER=BETON)),
    AFFE_VARC=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS"), NOM_VARC="TEMP", CHAM_GD=T_TP, VALE_REF=0.0),
)
TP = MECA_STATIQUE(MODELE=MODELE, CHAM_MATER=M_TP, CARA_ELEM=CARA, EXCIT=_F(CHARGE=CL), SOLVEUR=_F(METHODE="MUMPS"))
TP = CALC_CHAMP(reuse=TP, RESULTAT=TP, GROUP_MA="SEMELLE", CONTRAINTE=("EFGE_NOEU",))
TP = CALC_CHAMP(reuse=TP, RESULTAT=TP, GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS", "CHEVETRE", "POTEAUX"), CONTRAINTE=("EFGE_ELNO",))
TP = CALC_CHAMP(reuse=TP, RESULTAT=TP, FORCE=("REAC_NODA",))
# T− = −28 °C, tout l'aluminium (jeu B)
T_TM = CREA_CHAMP(OPERATION="AFFE", TYPE_CHAM="NOEU_TEMP_R", MAILLAGE=MAIL, AFFE=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS"), NOM_CMP="TEMP", VALE=-28.0))
M_TM = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS"), MATER=ALU), _F(GROUP_MA=("CHEVETRE", "POTEAUX", "SEMELLE"), MATER=BETON)),
    AFFE_VARC=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS"), NOM_VARC="TEMP", CHAM_GD=T_TM, VALE_REF=0.0),
)
TM = MECA_STATIQUE(MODELE=MODELE, CHAM_MATER=M_TM, CARA_ELEM=CARA, EXCIT=_F(CHARGE=CL), SOLVEUR=_F(METHODE="MUMPS"))
TM = CALC_CHAMP(reuse=TM, RESULTAT=TM, GROUP_MA="SEMELLE", CONTRAINTE=("EFGE_NOEU",))
TM = CALC_CHAMP(reuse=TM, RESULTAT=TM, GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS", "CHEVETRE", "POTEAUX"), CONTRAINTE=("EFGE_ELNO",))
TM = CALC_CHAMP(reuse=TM, RESULTAT=TM, FORCE=("REAC_NODA",))
# TA+ = +56 °C, poutres, montants, diagonales (jeu A, S2)
T_TAP = CREA_CHAMP(OPERATION="AFFE", TYPE_CHAM="NOEU_TEMP_R", MAILLAGE=MAIL, AFFE=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES"), NOM_CMP="TEMP", VALE=56.0))
M_TAP = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS"), MATER=ALU), _F(GROUP_MA=("CHEVETRE", "POTEAUX", "SEMELLE"), MATER=BETON)),
    AFFE_VARC=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES"), NOM_VARC="TEMP", CHAM_GD=T_TAP, VALE_REF=0.0),
)
TAP = MECA_STATIQUE(MODELE=MODELE, CHAM_MATER=M_TAP, CARA_ELEM=CARA, EXCIT=_F(CHARGE=CL), SOLVEUR=_F(METHODE="MUMPS"))
TAP = CALC_CHAMP(reuse=TAP, RESULTAT=TAP, GROUP_MA="SEMELLE", CONTRAINTE=("EFGE_NOEU",))
TAP = CALC_CHAMP(reuse=TAP, RESULTAT=TAP, GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS", "CHEVETRE", "POTEAUX"), CONTRAINTE=("EFGE_ELNO",))
TAP = CALC_CHAMP(reuse=TAP, RESULTAT=TAP, FORCE=("REAC_NODA",))
# TA− = −23 °C, poutres, montants, diagonales (jeu A, S2)
T_TAM = CREA_CHAMP(OPERATION="AFFE", TYPE_CHAM="NOEU_TEMP_R", MAILLAGE=MAIL, AFFE=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES"), NOM_CMP="TEMP", VALE=-23.0))
M_TAM = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS"), MATER=ALU), _F(GROUP_MA=("CHEVETRE", "POTEAUX", "SEMELLE"), MATER=BETON)),
    AFFE_VARC=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES"), NOM_VARC="TEMP", CHAM_GD=T_TAM, VALE_REF=0.0),
)
TAM = MECA_STATIQUE(MODELE=MODELE, CHAM_MATER=M_TAM, CARA_ELEM=CARA, EXCIT=_F(CHARGE=CL), SOLVEUR=_F(METHODE="MUMPS"))
TAM = CALC_CHAMP(reuse=TAM, RESULTAT=TAM, GROUP_MA="SEMELLE", CONTRAINTE=("EFGE_NOEU",))
TAM = CALC_CHAMP(reuse=TAM, RESULTAT=TAM, GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS", "CHEVETRE", "POTEAUX"), CONTRAINTE=("EFGE_ELNO",))
TAM = CALC_CHAMP(reuse=TAM, RESULTAT=TAM, FORCE=("REAC_NODA",))

# ---------------------------------------------------------------- 8. SORTIES
# Tables du contrôle d'équilibre (niveau D) : RP_<cas> réactions côté quai, DS_<cas>
# déplacements des nœuds de la semelle (efforts des ressorts k·u).
T_RP_G1 = POST_RELEVE_T(ACTION=_F(OPERATION="EXTRACTION", INTITULE="RP_G1", RESULTAT=ELEM, NOM_CHAM="REAC_NODA", NOM_CAS="G1", GROUP_NO="APP_QUAI", RESULTANTE=("DX", "DY", "DZ")))
IMPR_TABLE(TABLE=T_RP_G1, UNITE=6, FORMAT_R="E20.12")
