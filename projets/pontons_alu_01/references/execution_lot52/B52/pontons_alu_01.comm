# Températures uniformes (P10), CA-054 : un champ de matériau par cas.
# T+ = +46 °C, tout l'aluminium
T_TP = CREA_CHAMP(OPERATION="AFFE", TYPE_CHAM="NOEU_TEMP_R", MAILLAGE=MAIL, AFFE=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "PANNE_RIVE"), NOM_CMP="TEMP", VALE=46.0))
M_TP = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "PANNE_RIVE"), MATER=ALU), _F(GROUP_MA=("CHEVETRES", "LONGRINES", "PILES", "SEMELLE"), MATER=BETON), _F(GROUP_MA="ANGLES_ANNEAU", MATER=BETON0)),
    AFFE_VARC=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "PANNE_RIVE"), NOM_VARC="TEMP", CHAM_GD=T_TP, VALE_REF=0.0),
)
TP = MECA_STATIQUE(MODELE=MODELE, CHAM_MATER=M_TP, CARA_ELEM=CARA, EXCIT=_F(CHARGE=CL), SOLVEUR=_F(METHODE="MUMPS"))
TP = CALC_CHAMP(reuse=TP, RESULTAT=TP, GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "PANNE_RIVE", "CHEVETRES", "LONGRINES", "PILES"), CONTRAINTE=("EFGE_ELNO",))
