M_TAM = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "PANNE_RIVE"), MATER=ALU), _F(GROUP_MA=("CHEVETRES", "LONGRINES", "PILES", "SEMELLE"), MATER=BETON), _F(GROUP_MA="ANGLES_ANNEAU", MATER=BETON0)),
    AFFE_VARC=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES"), NOM_VARC="TEMP", CHAM_GD=T_TAM, VALE_REF=0.0),
)
TAM = MECA_STATIQUE(MODELE=MODELE, CHAM_MATER=M_TAM, CARA_ELEM=CARA, EXCIT=_F(CHARGE=CL), SOLVEUR=_F(METHODE="MUMPS"))
TAM = CALC_CHAMP(reuse=TAM, RESULTAT=TAM, GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "PANNE_RIVE", "CHEVETRES", "LONGRINES", "PILES"), CONTRAINTE=("EFGE_ELNO",))
TAM = CALC_CHAMP(reuse=TAM, RESULTAT=TAM, FORCE=("REAC_NODA",))

# ---------------------------------------------------------------- 8. SORTIES
