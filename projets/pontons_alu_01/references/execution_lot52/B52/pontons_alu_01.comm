# T− = −28 °C, tout l'aluminium
T_TM = CREA_CHAMP(OPERATION="AFFE", TYPE_CHAM="NOEU_TEMP_R", MAILLAGE=MAIL, AFFE=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "PANNE_RIVE"), NOM_CMP="TEMP", VALE=-28.0))
