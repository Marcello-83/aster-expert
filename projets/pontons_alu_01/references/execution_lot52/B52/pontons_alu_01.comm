# ---------------------------------------------------------------- 6. CAS DE CHARGE
CG1 = AFFE_CHAR_MECA(MODELE=MODELE, PESANTEUR=_F(GRAVITE=9.81, DIRECTION=(0.0, 0.0, -1.0)))
# P49 : déjaugeage du béton seul (P55 : tubes percés, aucune flottabilité de l'aluminium),
# 10000 N/m³ × section (barres de béton, N/m ; angles de l'anneau exclus) ou × épaisseur
# (semelles, N/m², FORCE_COQUE en repère global, PAT-005), vers le haut.
CDEJ = AFFE_CHAR_MECA(
    MODELE=MODELE,
    FORCE_POUTRE=(
        _F(GROUP_MA=("CHEVETRES", "LONGRINES_COURANT"), FZ=1600.0000000000002),  # 0.4 × 0.4 m
        _F(GROUP_MA="PILES", FZ=1963.4954084936207),  # Ø 0.5 m
    ),
    FORCE_COQUE=_F(GROUP_MA="SEMELLE", FZ=2000.0),  # e = 0.2 m
)
# Actions réparties (P22, P56) : FORCE_POUTRE sur les barres longitudinales, FZ = pression ×
# largeur portée par chaque barre ; une charge par module (M0 = T1, Mk = PTk + T(k+1),
# M5 = PT5 + PF) ; le cas total est la somme de ses modules.
