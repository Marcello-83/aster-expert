# PONTONS-ALU-01, lot 52 : ponton intégral, géométrie PRO (culée, 5 palées, 5 grandes travées,
# porte-à-faux d'extrémité), treillis horizontal constructible (P64), appuis articulés à axe (P65).
# Calcul linéaire, cas élémentaires unitaires.
# Variante B52 : panne B (piles 1,30 à 3,90 m, Lpf 1,25 m), poutres principales 200 × 200 × 12, pannes 50 × 50 × 5, montants et diagonales 120 × 120 × 6 sous les pannes (P64).
# Code_Aster 17.4. Unités : m, N, Pa, °C. Maillage : maillage_ponton_52.med (maillage_ponton_52.py).
# Généré par pontons_alu_01.generation_lot52 à partir de la fiche (P1 à P66), des données
# et de variantes_lot52.yaml : régénérer plutôt qu'éditer. Combinaisons et exports :
# post-traitement (scripts/lot52.py).
# P63, P64 : montants et diagonales tube 120 × 120 × 6 mm (6082-T6), axe +1.29 sous les pannes ; nœud diagonale–montant à e = 0.25 m de l'axe des poutres.
# CA-036 : les nœuds d'appui de la culée et les oreilles des appuis à axe sont liés aux montants
# (LM_) ; leur REAC_NODA porte l'effort de la liaison. Le relevé R<cas> du harnais porte donc sur
# APP_CULEE et les bouts de montant qui y sont liés, et l'unité 33 sur les bouts liés aux oreilles.
#
# Géométrie et cotes (rappel, m NGF)
#   travées : T1 0 → 6.25 ; PT1 6.251 → 7.769 ; T2 7.77 → 14.02 ; PT2 14.021 → 15.539 ; T3 15.54 → 21.79 ; PT3 21.791 → 23.309 ; T4 23.31 → 29.56 ; PT4 29.561 → 31.079 ; T5 31.08 → 37.33 ; PT5 37.331 → 38.85 ; PF 38.85 → 40.1 (m, X depuis la ligne d'appui de la culée)
#   B = 1.86 m, tablier 2.0 m (P35) ; dessus +1.4, poutres +1.3, pannes +1.375 (P53)
#   axe d'appui +1.175 (P54), dessus des chevêtres +1.09, axe de l'anneau +0.89, têtes de piles +0.69
#   piles (hauteur libre, m) : P1 1.3 (plan moyen de la semelle -0.71) ; P2 1.95 (plan moyen de la semelle -1.36) ; P3 2.5 (plan moyen de la semelle -1.91) ; P4 3.5 (plan moyen de la semelle -2.91) ; P5 3.9 (plan moyen de la semelle -3.31)
#   poutres principales tube 200 × 200 × 12 mm, pannes et panne de rive tube 50 × 50 × 5 mm ; anneau 0.4 × 0.4 m ; piles Ø 0.5 m, 4 têtes encastrées par palée (P46)
#   semelles 2.60 × 2.60 × 0.2 m (P48) ; sol kn = 5e+06 N/m³, kt = 1e+06 N/m³ (P19)

DEBUT(CODE="OUI")

# ---------------------------------------------------------------- 1. MAILLAGE
MAIL0 = LIRE_MAILLAGE(FORMAT="MED", UNITE=20)
# Appui élastique réparti (P19) : une maille POI1 par nœud de chaque semelle (ssls135a),
# un groupe POI1 par semelle (CA-034 : une maille par nœud).
MAIL = CREA_MAILLAGE(
    MAILLAGE=MAIL0,
    CREA_POI1=(_F(NOM_GROUP_MA="SOL_P1", GROUP_MA="SEMELLE_P1"), _F(NOM_GROUP_MA="SOL_P2", GROUP_MA="SEMELLE_P2"), _F(NOM_GROUP_MA="SOL_P3", GROUP_MA="SEMELLE_P3"), _F(NOM_GROUP_MA="SOL_P4", GROUP_MA="SEMELLE_P4"), _F(NOM_GROUP_MA="SOL_P5", GROUP_MA="SEMELLE_P5")),
)
MAIL = DEFI_GROUP(reuse=MAIL, MAILLAGE=MAIL, CREA_GROUP_NO=_F(GROUP_MA="SEMELLE", NOM="N_SEMELLE"))

# ---------------------------------------------------------------- 2. MODÈLE
# Barres : POU_D_T ; semelles : DKT ; sol : DIS_T (P19).
MODELE = AFFE_MODELE(
    MAILLAGE=MAIL,
    AFFE=(
        _F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "PANNE_RIVE", "CHEVETRES", "LONGRINES", "PILES"), PHENOMENE="MECANIQUE", MODELISATION="POU_D_T"),
        _F(GROUP_MA="SEMELLE", PHENOMENE="MECANIQUE", MODELISATION="DKT"),
        _F(GROUP_MA=("SOL_P1", "SOL_P2", "SOL_P3", "SOL_P4", "SOL_P5"), PHENOMENE="MECANIQUE", MODELISATION="DIS_T"),
    ),
)

# ---------------------------------------------------------------- 3. MATÉRIAUX
# RHO = γ / g (CA-048). Températures : aluminium seulement (P10). BETON0 : angles de l'anneau
# (morceaux de longrine dans l'épaisseur d'un chevêtre), même raideur, sans poids : chaque
# m³ de l'anneau n'est pesé qu'une fois (correction du lot 51 ter).
ALU = DEFI_MATERIAU(ELAS=_F(E=70000000000.0, NU=0.3, RHO=2752.293577981651, ALPHA=2.3e-05))
BETON = DEFI_MATERIAU(ELAS=_F(E=34000000000.0, NU=0.2, RHO=2548.41997961264))
BETON0 = DEFI_MATERIAU(ELAS=_F(E=34000000000.0, NU=0.2, RHO=0.0))
CHMAT = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "PANNE_RIVE"), MATER=ALU), _F(GROUP_MA=("CHEVETRES", "LONGRINES", "PILES", "SEMELLE"), MATER=BETON), _F(GROUP_MA="ANGLES_ANNEAU", MATER=BETON0)),
)

# ---------------------------------------------------------------- 4. CARACTÉRISTIQUES
# Tubes carrés à angles vifs : A, I et JX (Bredt) calculés par Code_Aster (U4.42.01).
# Repère local : z_l = +Z pour les barres horizontales (VECT_Z), y_l = +X pour les piles.
CARA = AFFE_CARA_ELEM(
    MODELE=MODELE,
    POUTRE=(
        _F(GROUP_MA="POUTRES_PRINC", SECTION="RECTANGLE", CARA=("H", "EP"), VALE=(0.2, 0.012)),
        _F(GROUP_MA=("MONTANTS", "DIAGONALES"), SECTION="RECTANGLE", CARA=("H", "EP"), VALE=(0.12, 0.006)),
        _F(GROUP_MA=("PANNES_SEC", "PANNE_RIVE"), SECTION="RECTANGLE", CARA=("H", "EP"), VALE=(0.05, 0.005)),
        _F(GROUP_MA=("CHEVETRES", "LONGRINES"), SECTION="RECTANGLE", CARA=("HY", "HZ"), VALE=(0.4, 0.4)),
        _F(GROUP_MA="PILES", SECTION="CERCLE", CARA=("R",), VALE=(0.25,)),
    ),
    ORIENTATION=(
        _F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "PANNE_RIVE", "CHEVETRES", "LONGRINES"), CARA="VECT_Z", VALE=(0.0, 0.0, 1.0)),
        _F(GROUP_MA="PILES", CARA="VECT_Y", VALE=(1.0, 0.0, 0.0)),
    ),
    COQUE=_F(GROUP_MA="SEMELLE", EPAIS=0.2, ANGL_REP=(0.0, 0.0)),
    DISCRET=_F(GROUP_MA=("SOL_P1", "SOL_P2", "SOL_P3", "SOL_P4", "SOL_P5"), CARA="M_T_D_N", VALE=0.0),
    # P19 : raideurs globales k × surface de chaque semelle, réparties au prorata des
    # surfaces (U4.42.01), une occurrence par semelle.
    RIGI_PARASOL=(
        _F(GROUP_MA="SEMELLE_P1", GROUP_MA_POI1="SOL_P1", COEF_GROUP=1.0, CARA="K_T_D_N", VALE=(6760000.000000002, 6760000.000000002, 33800000.00000001), COOR_CENTRE=(7.01, 0.0, -0.71)),
        _F(GROUP_MA="SEMELLE_P2", GROUP_MA_POI1="SOL_P2", COEF_GROUP=1.0, CARA="K_T_D_N", VALE=(6759999.999999994, 6759999.999999994, 33799999.99999997), COOR_CENTRE=(14.78, 0.0, -1.36)),
        _F(GROUP_MA="SEMELLE_P3", GROUP_MA_POI1="SOL_P3", COEF_GROUP=1.0, CARA="K_T_D_N", VALE=(6760000.000000005, 6760000.000000005, 33800000.00000002), COOR_CENTRE=(22.55, 0.0, -1.91)),
        _F(GROUP_MA="SEMELLE_P4", GROUP_MA_POI1="SOL_P4", COEF_GROUP=1.0, CARA="K_T_D_N", VALE=(6760000.000000005, 6760000.000000005, 33800000.00000002), COOR_CENTRE=(30.32, 0.0, -2.91)),
        _F(GROUP_MA="SEMELLE_P5", GROUP_MA_POI1="SOL_P5", COEF_GROUP=1.0, CARA="K_T_D_N", VALE=(6760000.000000005, 6760000.000000005, 33800000.00000002), COOR_CENTRE=(38.09, 0.0, -3.31)),
    ),
)

# ---------------------------------------------------------------- 5. LIAISONS ET APPUIS
# Culée (X = 0, P58) : seul point fixe longitudinal ; axe YP : X, Y, Z bloqués ; axe YM :
# X, Z bloqués. LIAISON_SOLIDE (P64) : pannes posées sur les montants et les diagonales (LR_, 0,085 m), montants soudés sur le flanc des poutres principales (LM_, 0,01 m), pannes du porte-à-faux / panne de rive (LR_ de PF),
# têtes de piles encastrées dans les chevêtres (TP_, P46), angles de l'anneau monolithique
# (LG_), pieds de piles / semelles (PS_).
# P44, P54, appuis à axe (axe parallèle à Y, point P non maillé, Z = +1,175) : LIAISON_DDL sur
# la translation de P portée par un nœud N, u_N + θ_N ∧ (P − N) ; oreilles des deux travées
# (AX_<palée><chevêtre>_<rive>_1 et _2) : translations de P égales et DRX égales ; oreille 1 et
# nœud du chevêtre (_K) : Z égal, et Y égal en YP ; X libre (trou oblong). Chevêtre C2 de la
# dernière palée : une seule oreille (petite travée continue avec le porte-à-faux).
CL = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=(_F(GROUP_NO="APP_CULEE_YP", DX=0.0, DY=0.0, DZ=0.0), _F(GROUP_NO="APP_CULEE_YM", DX=0.0, DZ=0.0)),
