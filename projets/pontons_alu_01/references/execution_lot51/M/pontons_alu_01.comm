CAM08 = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_NODALE=_F(GROUP_NO="TQ2_YP", FX=1000.0))  # AMX_TQ2_YP
CAM09 = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_NODALE=_F(GROUP_NO="TQ3_YM", FY=-1000.0))  # AMY_TQ3_YM
CAM10 = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_NODALE=_F(GROUP_NO="TQ3_YM", FX=1000.0))  # AMX_TQ3_YM
CAM11 = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_NODALE=_F(GROUP_NO="TQ3_YP", FY=1000.0))  # AMY_TQ3_YP
CAM12 = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_NODALE=_F(GROUP_NO="TQ3_YP", FX=1000.0))  # AMX_TQ3_YP
CAM13 = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_NODALE=_F(GROUP_NO="TQ4_YM", FY=-1000.0))  # AMY_TQ4_YM
CAM14 = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_NODALE=_F(GROUP_NO="TQ4_YM", FX=1000.0))  # AMX_TQ4_YM
CAM15 = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_NODALE=_F(GROUP_NO="TQ4_YP", FY=1000.0))  # AMY_TQ4_YP
CAM16 = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_NODALE=_F(GROUP_NO="TQ4_YP", FX=1000.0))  # AMX_TQ4_YP

# ---------------------------------------------------------------- 7. RÉSOLUTION
# Cas mécaniques : une factorisation (MACRO_ELAS_MULT, CA-055) ; un cas total = somme
# des charges de ses travées.
ELEM = MACRO_ELAS_MULT(
    MODELE=MODELE,
    CHAM_MATER=CHMAT,
    CARA_ELEM=CARA,
    CHAR_MECA_GLOBAL=CL,
    CAS_CHARGE=(
        _F(NOM_CAS="G1", CHAR_MECA=CG1, OPTION="SANS"),
        _F(NOM_CAS="G2", CHAR_MECA=(CG2T1, CG2PT, CG2T2), OPTION="SANS"),
        _F(NOM_CAS="G2_T1", CHAR_MECA=CG2T1, OPTION="SANS"),
        _F(NOM_CAS="G2_PT", CHAR_MECA=CG2PT, OPTION="SANS"),
        _F(NOM_CAS="G2_T2", CHAR_MECA=CG2T2, OPTION="SANS"),
        _F(NOM_CAS="Q", CHAR_MECA=(CQT1, CQPT, CQT2), OPTION="SANS"),
        _F(NOM_CAS="Q_T1", CHAR_MECA=CQT1, OPTION="SANS"),
        _F(NOM_CAS="Q_PT", CHAR_MECA=CQPT, OPTION="SANS"),
        _F(NOM_CAS="Q_T2", CHAR_MECA=CQT2, OPTION="SANS"),
        _F(NOM_CAS="QD", CHAR_MECA=CQD, OPTION="SANS"),
        _F(NOM_CAS="HU", CHAR_MECA=(CHUT1, CHUPT, CHUT2), OPTION="SANS"),
        _F(NOM_CAS="HU_T1", CHAR_MECA=CHUT1, OPTION="SANS"),
        _F(NOM_CAS="HU_PT", CHAR_MECA=CHUPT, OPTION="SANS"),
        _F(NOM_CAS="HU_T2", CHAR_MECA=CHUT2, OPTION="SANS"),
        _F(NOM_CAS="HD", CHAR_MECA=(CHDT1, CHDPT, CHDT2), OPTION="SANS"),
        _F(NOM_CAS="HD_T1", CHAR_MECA=CHDT1, OPTION="SANS"),
        _F(NOM_CAS="HD_PT", CHAR_MECA=CHDPT, OPTION="SANS"),
        _F(NOM_CAS="HD_T2", CHAR_MECA=CHDT2, OPTION="SANS"),
        _F(NOM_CAS="ACN_QU_YM", CHAR_MECA=CAC01, OPTION="SANS"),
        _F(NOM_CAS="ACX_QU_YM", CHAR_MECA=CAC02, OPTION="SANS"),
        _F(NOM_CAS="ACZ_QU_YM", CHAR_MECA=CAC03, OPTION="SANS"),
        _F(NOM_CAS="ACN_QU_YP", CHAR_MECA=CAC04, OPTION="SANS"),
        _F(NOM_CAS="ACX_QU_YP", CHAR_MECA=CAC05, OPTION="SANS"),
        _F(NOM_CAS="ACZ_QU_YP", CHAR_MECA=CAC06, OPTION="SANS"),
        _F(NOM_CAS="ACN_MI1_YM", CHAR_MECA=CAC07, OPTION="SANS"),
        _F(NOM_CAS="ACX_MI1_YM", CHAR_MECA=CAC08, OPTION="SANS"),
        _F(NOM_CAS="ACZ_MI1_YM", CHAR_MECA=CAC09, OPTION="SANS"),
        _F(NOM_CAS="ACN_MI1_YP", CHAR_MECA=CAC10, OPTION="SANS"),
        _F(NOM_CAS="ACX_MI1_YP", CHAR_MECA=CAC11, OPTION="SANS"),
        _F(NOM_CAS="ACZ_MI1_YP", CHAR_MECA=CAC12, OPTION="SANS"),
        _F(NOM_CAS="ACN_CH1_YM", CHAR_MECA=CAC13, OPTION="SANS"),
        _F(NOM_CAS="ACX_CH1_YM", CHAR_MECA=CAC14, OPTION="SANS"),
        _F(NOM_CAS="ACZ_CH1_YM", CHAR_MECA=CAC15, OPTION="SANS"),
        _F(NOM_CAS="ACN_CH1_YP", CHAR_MECA=CAC16, OPTION="SANS"),
        _F(NOM_CAS="ACX_CH1_YP", CHAR_MECA=CAC17, OPTION="SANS"),
        _F(NOM_CAS="ACZ_CH1_YP", CHAR_MECA=CAC18, OPTION="SANS"),
        _F(NOM_CAS="ACN_PT_YM", CHAR_MECA=CAC19, OPTION="SANS"),
        _F(NOM_CAS="ACX_PT_YM", CHAR_MECA=CAC20, OPTION="SANS"),
        _F(NOM_CAS="ACZ_PT_YM", CHAR_MECA=CAC21, OPTION="SANS"),
        _F(NOM_CAS="ACN_PT_YP", CHAR_MECA=CAC22, OPTION="SANS"),
        _F(NOM_CAS="ACX_PT_YP", CHAR_MECA=CAC23, OPTION="SANS"),
        _F(NOM_CAS="ACZ_PT_YP", CHAR_MECA=CAC24, OPTION="SANS"),
        _F(NOM_CAS="ACN_PA2_YM", CHAR_MECA=CAC25, OPTION="SANS"),
        _F(NOM_CAS="ACX_PA2_YM", CHAR_MECA=CAC26, OPTION="SANS"),
        _F(NOM_CAS="ACZ_PA2_YM", CHAR_MECA=CAC27, OPTION="SANS"),
        _F(NOM_CAS="ACN_PA2_YP", CHAR_MECA=CAC28, OPTION="SANS"),
        _F(NOM_CAS="ACX_PA2_YP", CHAR_MECA=CAC29, OPTION="SANS"),
        _F(NOM_CAS="ACZ_PA2_YP", CHAR_MECA=CAC30, OPTION="SANS"),
        _F(NOM_CAS="AMY_TQ1_YM", CHAR_MECA=CAM01, OPTION="SANS"),
        _F(NOM_CAS="AMX_TQ1_YM", CHAR_MECA=CAM02, OPTION="SANS"),
        _F(NOM_CAS="AMY_TQ1_YP", CHAR_MECA=CAM03, OPTION="SANS"),
        _F(NOM_CAS="AMX_TQ1_YP", CHAR_MECA=CAM04, OPTION="SANS"),
        _F(NOM_CAS="AMY_TQ2_YM", CHAR_MECA=CAM05, OPTION="SANS"),
        _F(NOM_CAS="AMX_TQ2_YM", CHAR_MECA=CAM06, OPTION="SANS"),
        _F(NOM_CAS="AMY_TQ2_YP", CHAR_MECA=CAM07, OPTION="SANS"),
        _F(NOM_CAS="AMX_TQ2_YP", CHAR_MECA=CAM08, OPTION="SANS"),
        _F(NOM_CAS="AMY_TQ3_YM", CHAR_MECA=CAM09, OPTION="SANS"),
        _F(NOM_CAS="AMX_TQ3_YM", CHAR_MECA=CAM10, OPTION="SANS"),
        _F(NOM_CAS="AMY_TQ3_YP", CHAR_MECA=CAM11, OPTION="SANS"),
        _F(NOM_CAS="AMX_TQ3_YP", CHAR_MECA=CAM12, OPTION="SANS"),
        _F(NOM_CAS="AMY_TQ4_YM", CHAR_MECA=CAM13, OPTION="SANS"),
        _F(NOM_CAS="AMX_TQ4_YM", CHAR_MECA=CAM14, OPTION="SANS"),
        _F(NOM_CAS="AMY_TQ4_YP", CHAR_MECA=CAM15, OPTION="SANS"),
        _F(NOM_CAS="AMX_TQ4_YP", CHAR_MECA=CAM16, OPTION="SANS"),
    ),
    SOLVEUR=_F(METHODE="MUMPS", POSTTRAITEMENTS="FORCE"),
)
ELEM = CALC_CHAMP(reuse=ELEM, RESULTAT=ELEM, GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS", "CHEVETRES", "LONGRINES", "PILES"), CONTRAINTE=("EFGE_ELNO",))
ELEM = CALC_CHAMP(reuse=ELEM, RESULTAT=ELEM, FORCE=("REAC_NODA",))
# Températures uniformes (P10), CA-054 : un champ de matériau par cas.
# T+ = +46 °C, tout l'aluminium
T_TP = CREA_CHAMP(OPERATION="AFFE", TYPE_CHAM="NOEU_TEMP_R", MAILLAGE=MAIL, AFFE=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS"), NOM_CMP="TEMP", VALE=46.0))
M_TP = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS"), MATER=ALU), _F(GROUP_MA=("CHEVETRES", "LONGRINES", "PILES", "SEMELLE"), MATER=BETON)),
    AFFE_VARC=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS"), NOM_VARC="TEMP", CHAM_GD=T_TP, VALE_REF=0.0),
)
TP = MECA_STATIQUE(MODELE=MODELE, CHAM_MATER=M_TP, CARA_ELEM=CARA, EXCIT=_F(CHARGE=CL), SOLVEUR=_F(METHODE="MUMPS"))
TP = CALC_CHAMP(reuse=TP, RESULTAT=TP, GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS", "CHEVETRES", "LONGRINES", "PILES"), CONTRAINTE=("EFGE_ELNO",))
TP = CALC_CHAMP(reuse=TP, RESULTAT=TP, FORCE=("REAC_NODA",))
# T− = −28 °C, tout l'aluminium
T_TM = CREA_CHAMP(OPERATION="AFFE", TYPE_CHAM="NOEU_TEMP_R", MAILLAGE=MAIL, AFFE=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS"), NOM_CMP="TEMP", VALE=-28.0))
M_TM = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS"), MATER=ALU), _F(GROUP_MA=("CHEVETRES", "LONGRINES", "PILES", "SEMELLE"), MATER=BETON)),
    AFFE_VARC=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS"), NOM_VARC="TEMP", CHAM_GD=T_TM, VALE_REF=0.0),
)
TM = MECA_STATIQUE(MODELE=MODELE, CHAM_MATER=M_TM, CARA_ELEM=CARA, EXCIT=_F(CHARGE=CL), SOLVEUR=_F(METHODE="MUMPS"))
TM = CALC_CHAMP(reuse=TM, RESULTAT=TM, GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS", "CHEVETRES", "LONGRINES", "PILES"), CONTRAINTE=("EFGE_ELNO",))
TM = CALC_CHAMP(reuse=TM, RESULTAT=TM, FORCE=("REAC_NODA",))
# TA+ = +56 °C, poutres, montants, diagonales (S2)
T_TAP = CREA_CHAMP(OPERATION="AFFE", TYPE_CHAM="NOEU_TEMP_R", MAILLAGE=MAIL, AFFE=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES"), NOM_CMP="TEMP", VALE=56.0))
M_TAP = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS"), MATER=ALU), _F(GROUP_MA=("CHEVETRES", "LONGRINES", "PILES", "SEMELLE"), MATER=BETON)),
    AFFE_VARC=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES"), NOM_VARC="TEMP", CHAM_GD=T_TAP, VALE_REF=0.0),
)
TAP = MECA_STATIQUE(MODELE=MODELE, CHAM_MATER=M_TAP, CARA_ELEM=CARA, EXCIT=_F(CHARGE=CL), SOLVEUR=_F(METHODE="MUMPS"))
TAP = CALC_CHAMP(reuse=TAP, RESULTAT=TAP, GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS", "CHEVETRES", "LONGRINES", "PILES"), CONTRAINTE=("EFGE_ELNO",))
TAP = CALC_CHAMP(reuse=TAP, RESULTAT=TAP, FORCE=("REAC_NODA",))
# TA− = −23 °C, poutres, montants, diagonales (S2)
T_TAM = CREA_CHAMP(OPERATION="AFFE", TYPE_CHAM="NOEU_TEMP_R", MAILLAGE=MAIL, AFFE=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES"), NOM_CMP="TEMP", VALE=-23.0))
M_TAM = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS"), MATER=ALU), _F(GROUP_MA=("CHEVETRES", "LONGRINES", "PILES", "SEMELLE"), MATER=BETON)),
    AFFE_VARC=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES"), NOM_VARC="TEMP", CHAM_GD=T_TAM, VALE_REF=0.0),
)
TAM = MECA_STATIQUE(MODELE=MODELE, CHAM_MATER=M_TAM, CARA_ELEM=CARA, EXCIT=_F(CHARGE=CL), SOLVEUR=_F(METHODE="MUMPS"))
TAM = CALC_CHAMP(reuse=TAM, RESULTAT=TAM, GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS", "CHEVETRES", "LONGRINES", "PILES"), CONTRAINTE=("EFGE_ELNO",))
TAM = CALC_CHAMP(reuse=TAM, RESULTAT=TAM, FORCE=("REAC_NODA",))

# ---------------------------------------------------------------- 8. SORTIES
# Harnais D (listing, E20.12) : RP_<cas> rotules du quai, RF_<cas> pieds fixes en
# X = 14,02, DS_<cas> déplacements des nœuds de la semelle (efforts des ressorts k·u).
TRP = POST_RELEVE_T(ACTION=_F(OPERATION="EXTRACTION", INTITULE="RP_G1", RESULTAT=ELEM, NOM_CHAM="REAC_NODA", NOM_CAS="G1", GROUP_NO="APP_QUAI", RESULTANTE=("DX", "DY", "DZ")))
