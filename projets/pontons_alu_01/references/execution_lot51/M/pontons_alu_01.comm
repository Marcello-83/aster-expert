# PONTONS-ALU-01, lot 51 : palée complète (4 piles, anneau BA), trois travées en
# aluminium soudé, appuis néoprène. Calcul linéaire, cas élémentaires unitaires.
# Variante M : appui mécanique articulé : Y et Z bloqués, X libre, rotations libres.
# Code_Aster 17.4. Unités : m, N, Pa, °C. Maillage : maillage_palee.med (maillage_palee.py,
# H_PILES = 1.32 m). Généré par pontons_alu_01.generation_lot51 à partir
# de la fiche (P1 à P43), des données et de variantes_lot51.yaml : régénérer plutôt
# qu'éditer. Combinaisons et exports : post-traitement (scripts/lot51.py).
#
# Paramètres (rappel)
#   travées T1 et T2 de 6.25 m, petite travée entre chevêtres en X = 6.25 et 7.77 ;
#   B = 1.86 m, tablier 2.0 m (P35), plan moyen +1.358, pannes +1.458
#   poutres principales tube 200 × 200 × 8 mm (P36) ; anneau 0.4 × 0.4 m (P43) ; piles Ø 0.5 m, H = 1.32 m (P41)
#   néoprènes (P38) : Kx = Ky = 2.25e+06 N/m (facteur 1), Kz = 4.76586e+08 N/m, Kθ = 0 ; appuis : mecanique
#   têtes de piles : C1_YM rotule, C1_YP rotule, C2_YM rotule, C2_YP rotule ; anneau monolithique ; éclissages articule (P42)
#   sol kn = 5e+06 N/m³, kt = 1e+06 N/m³ sous 7.3080 m² (P19)

DEBUT(CODE="OUI")

# ---------------------------------------------------------------- 1. MAILLAGE
MAIL0 = LIRE_MAILLAGE(FORMAT="MED", UNITE=20)
# Appui élastique réparti (P19) : une maille POI1 par nœud de la semelle (ssls135a).
MAIL = CREA_MAILLAGE(MAILLAGE=MAIL0, CREA_POI1=_F(NOM_GROUP_MA="SOL", GROUP_MA="SEMELLE"))
MAIL = DEFI_GROUP(reuse=MAIL, MAILLAGE=MAIL, CREA_GROUP_NO=_F(GROUP_MA="SEMELLE", NOM="N_SEMELLE"))

# ---------------------------------------------------------------- 2. MODÈLE
# Barres : POU_D_T ; semelle : DKT ; sol et néoprènes : DIS_T (P19, P38).
MODELE = AFFE_MODELE(
    MAILLAGE=MAIL,
    AFFE=(
        _F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS", "CHEVETRES", "LONGRINES", "PILES"), PHENOMENE="MECANIQUE", MODELISATION="POU_D_T"),
        _F(GROUP_MA="SEMELLE", PHENOMENE="MECANIQUE", MODELISATION="DKT"),
        _F(GROUP_MA=("SOL", "NEOPRENES"), PHENOMENE="MECANIQUE", MODELISATION="DIS_T"),
    ),
)

# ---------------------------------------------------------------- 3. MATÉRIAUX
# RHO = γ / g (CA-048). Températures : aluminium seulement (P10).
ALU = DEFI_MATERIAU(ELAS=_F(E=70000000000.0, NU=0.3, RHO=2752.293577981651, ALPHA=2.3e-05))
BETON = DEFI_MATERIAU(ELAS=_F(E=34000000000.0, NU=0.2, RHO=2548.41997961264))
CHMAT = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "SUPPORTS"), MATER=ALU), _F(GROUP_MA=("CHEVETRES", "LONGRINES", "PILES", "SEMELLE"), MATER=BETON)),
)

# ---------------------------------------------------------------- 4. CARACTÉRISTIQUES
# Tubes carrés à angles vifs : A, I et JX (Bredt) calculés par Code_Aster (U4.42.01).
# Repère local : z_l = +Z pour les barres horizontales (VECT_Z), y_l = +X pour les verticales.
# Néoprènes (P38) : K_T_D_L dans le repère global (REPERE = GLOBAL), sans masse.
CARA = AFFE_CARA_ELEM(
    MODELE=MODELE,
    POUTRE=(
        _F(GROUP_MA="POUTRES_PRINC", SECTION="RECTANGLE", CARA=("H", "EP"), VALE=(0.2, 0.008)),
        _F(GROUP_MA=("MONTANTS", "DIAGONALES", "SUPPORTS"), SECTION="RECTANGLE", CARA=("H", "EP"), VALE=(0.15, 0.007)),
        _F(GROUP_MA="PANNES_SEC", SECTION="RECTANGLE", CARA=("H", "EP"), VALE=(0.05, 0.005)),
        _F(GROUP_MA=("CHEVETRES", "LONGRINES"), SECTION="RECTANGLE", CARA=("HY", "HZ"), VALE=(0.4, 0.4)),
        _F(GROUP_MA="PILES", SECTION="CERCLE", CARA=("R",), VALE=(0.25,)),
    ),
    ORIENTATION=(
        _F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "CHEVETRES", "LONGRINES"), CARA="VECT_Z", VALE=(0.0, 0.0, 1.0)),
        _F(GROUP_MA=("SUPPORTS", "PILES"), CARA="VECT_Y", VALE=(1.0, 0.0, 0.0)),
    ),
    COQUE=_F(GROUP_MA="SEMELLE", EPAIS=0.25, ANGL_REP=(0.0, 0.0)),
    DISCRET=(
        _F(GROUP_MA="SOL", CARA="M_T_D_N", VALE=0.0),
        _F(GROUP_MA="NEOPRENES", CARA="M_T_D_L", VALE=0.0),
        _F(GROUP_MA="NEOPRENES", CARA="K_T_D_L", REPERE="GLOBAL", VALE=(0.0, 0.0, 0.0)),
    ),
    # P19 : raideurs globales k × surface, réparties au prorata des surfaces (U4.42.01).
    RIGI_PARASOL=_F(
        GROUP_MA="SEMELLE", GROUP_MA_POI1="SOL", COEF_GROUP=1.0, CARA="K_T_D_N",
        VALE=(7307999.999999999, 7307999.999999999, 36539999.99999999),
        COOR_CENTRE=(7.01, 0.0, -0.755),
    ),
)

# ---------------------------------------------------------------- 5. LIAISONS ET APPUIS
# P35 : rotule côté quai Y > 0 fixe, rotule Y < 0 guidée (libre en Y). Appuis de la
# travée 2 en X = 14,02 : pied des profilés supports encastré sur un support fixe.
# LIAISON_SOLIDE : pannes / montants et diagonales (LR_), pied des profilés supports /
# chevêtre (SC_, P39), pied de pile / semelle (PS_), et selon la variante tête de pile
# encastrée (TP_), anneau monolithique (LG_), éclissage continu (EC_). LIAISON_DDL :
# bras rigide u_A = u_B + θ_B ∧ (A − B) pour le haut du néoprène (BR_), la tête de pile
# en rotule (TP_), le bout de longrine indépendante (LG_ → tête de pile), l'éclissage
# articulé (EC_, plus DRX : rotations autour de y_l et z_l libres, P42).
CL = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=(_F(GROUP_NO="APP_QUAI_YP", DX=0.0, DY=0.0, DZ=0.0), _F(GROUP_NO="APP_QUAI_YM", DX=0.0, DZ=0.0), _F(GROUP_NO="APP_FIXE", DX=0.0, DY=0.0, DZ=0.0, DRX=0.0, DRY=0.0, DRZ=0.0)),
