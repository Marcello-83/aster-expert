        _F(GROUP_NO=("AX_A2_YP_1", "AX_A2_YP_1", "AX_A2_YP_2", "AX_A2_YP_2", "AX_A2_YP_2"), DDL=("DY", "DRX", "DY", "DRZ", "DRX"), COEF_MULT=(1.0, 0.27, -1.0, -0.001, -0.27,), COEF_IMPO=0.0),
        # axe commun, DZ
        _F(GROUP_NO=("AX_A2_YP_1", "AX_A2_YP_2", "AX_A2_YP_2"), DDL=("DZ", "DZ", "DRY"), COEF_MULT=(1.0, -1.0, 0.001,), COEF_IMPO=0.0),
        # éclissage articulé, torsion DRX
        _F(GROUP_NO=("AX_A2_YP_1", "AX_A2_YP_2"), DDL=("DRX", "DRX"), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        # appui sur le chevêtre, DY
        _F(GROUP_NO=("AX_A2_YP_1", "AX_A2_YP_1", "AX_A2_YP_K", "AX_A2_YP_K"), DDL=("DY", "DRX", "DY", "DRX"), COEF_MULT=(1.0, 0.27, -1.0, 0.5,), COEF_IMPO=0.0),
        # appui sur le chevêtre, DZ
        _F(GROUP_NO=("AX_A2_YP_1", "AX_A2_YP_K"), DDL=("DZ", "DZ"), COEF_MULT=(1.0, -1.0,), COEF_IMPO=0.0),
        # appui A3_YM : axe en (14.02, -0.93, 1.588), Y libre
        # appui sur support fixe, DZ
        _F(GROUP_NO=("AX_A3_YM_1",), DDL=("DZ",), COEF_MULT=(1.0,), COEF_IMPO=0.0),
        # appui A3_YP : axe en (14.02, 0.93, 1.588), Y bloqué
        # appui sur support fixe, DY
        _F(GROUP_NO=("AX_A3_YP_1", "AX_A3_YP_1"), DDL=("DY", "DRX"), COEF_MULT=(1.0, 0.27,), COEF_IMPO=0.0),
        # appui sur support fixe, DZ
        _F(GROUP_NO=("AX_A3_YP_1",), DDL=("DZ",), COEF_MULT=(1.0,), COEF_IMPO=0.0),
    ),
)

