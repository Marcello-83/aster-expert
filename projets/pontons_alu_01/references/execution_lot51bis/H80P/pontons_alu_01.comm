        _F(NOM_CAS="ACZ_MI1_YP", CHAR_MECA=CAC12, OPTION="SANS"),
        _F(NOM_CAS="ACN_CH1_YM", CHAR_MECA=CAC13, OPTION="SANS"),
        _F(NOM_CAS="ACX_CH1_YM", CHAR_MECA=CAC14, OPTION="SANS"),
        _F(NOM_CAS="ACZ_CH1_YM", CHAR_MECA=CAC15, OPTION="SANS"),
        _F(NOM_CAS="ACN_CH1_YP", CHAR_MECA=CAC16, OPTION="SANS"),
        _F(NOM_CAS="ACX_CH1_YP", CHAR_MECA=CAC17, OPTION="SANS"),
        _F(NOM_CAS="ACZ_CH1_YP", CHAR_MECA=CAC18, OPTION="SANS"),
        _F(NOM_CAS="ACN_PT_YM", CHAR_MECA=CAC19, OPTION="SANS"),
        _F(NOM_CAS="ACX_PT_YM", CHAR_MECA=CAC20, OPTION="SANS"),
        _F(NOM_CAS="ACZ_PT_YM", CHAR_MECA=CAC21, OPTION="SANS"),
        _F(NOM_CAS="ACN_PT_YP", CHAR_MECA=CAC22, OPTION="SANS"),
        _F(NOM_CAS="ACX_PT_YP", CHAR_MECA=CAC23, OPTION="SANS"),
        _F(NOM_CAS="ACZ_PT_YP", CHAR_MECA=CAC24, OPTION="SANS"),
        _F(NOM_CAS="ACN_PA2_YM", CHAR_MECA=CAC25, OPTION="SANS"),
        _F(NOM_CAS="ACX_PA2_YM", CHAR_MECA=CAC26, OPTION="SANS"),
        _F(NOM_CAS="ACZ_PA2_YM", CHAR_MECA=CAC27, OPTION="SANS"),
        _F(NOM_CAS="ACN_PA2_YP", CHAR_MECA=CAC28, OPTION="SANS"),
        _F(NOM_CAS="ACX_PA2_YP", CHAR_MECA=CAC29, OPTION="SANS"),
        _F(NOM_CAS="ACZ_PA2_YP", CHAR_MECA=CAC30, OPTION="SANS"),
        _F(NOM_CAS="AMY_TQ1_YM", CHAR_MECA=CAM01, OPTION="SANS"),
        _F(NOM_CAS="AMX_TQ1_YM", CHAR_MECA=CAM02, OPTION="SANS"),
        _F(NOM_CAS="AMY_TQ1_YP", CHAR_MECA=CAM03, OPTION="SANS"),
        _F(NOM_CAS="AMX_TQ1_YP", CHAR_MECA=CAM04, OPTION="SANS"),
        _F(NOM_CAS="AMY_TQ2_YM", CHAR_MECA=CAM05, OPTION="SANS"),
        _F(NOM_CAS="AMX_TQ2_YM", CHAR_MECA=CAM06, OPTION="SANS"),
        _F(NOM_CAS="AMY_TQ2_YP", CHAR_MECA=CAM07, OPTION="SANS"),
        _F(NOM_CAS="AMX_TQ2_YP", CHAR_MECA=CAM08, OPTION="SANS"),
        _F(NOM_CAS="AMY_TQ3_YM", CHAR_MECA=CAM09, OPTION="SANS"),
        _F(NOM_CAS="AMX_TQ3_YM", CHAR_MECA=CAM10, OPTION="SANS"),
        _F(NOM_CAS="AMY_TQ3_YP", CHAR_MECA=CAM11, OPTION="SANS"),
        _F(NOM_CAS="AMX_TQ3_YP", CHAR_MECA=CAM12, OPTION="SANS"),
        _F(NOM_CAS="AMY_TQ4_YM", CHAR_MECA=CAM13, OPTION="SANS"),
        _F(NOM_CAS="AMX_TQ4_YM", CHAR_MECA=CAM14, OPTION="SANS"),
        _F(NOM_CAS="AMY_TQ4_YP", CHAR_MECA=CAM15, OPTION="SANS"),
        _F(NOM_CAS="AMX_TQ4_YP", CHAR_MECA=CAM16, OPTION="SANS"),
    ),
    SOLVEUR=_F(METHODE="MUMPS", POSTTRAITEMENTS="FORCE"),
)
ELEM = CALC_CHAMP(reuse=ELEM, RESULTAT=ELEM, GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "CHEVETRES", "LONGRINES", "PILES"), CONTRAINTE=("EFGE_ELNO",))
ELEM = CALC_CHAMP(reuse=ELEM, RESULTAT=ELEM, FORCE=("REAC_NODA",))
# Températures uniformes (P10), CA-054 : un champ de matériau par cas.
# T+ = +46 °C, tout l'aluminium
T_TP = CREA_CHAMP(OPERATION="AFFE", TYPE_CHAM="NOEU_TEMP_R", MAILLAGE=MAIL, AFFE=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC"), NOM_CMP="TEMP", VALE=46.0))
M_TP = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC"), MATER=ALU), _F(GROUP_MA=("CHEVETRES", "LONGRINES", "PILES", "SEMELLE"), MATER=BETON)),
    AFFE_VARC=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC"), NOM_VARC="TEMP", CHAM_GD=T_TP, VALE_REF=0.0),
)
TP = MECA_STATIQUE(MODELE=MODELE, CHAM_MATER=M_TP, CARA_ELEM=CARA, EXCIT=_F(CHARGE=CL), SOLVEUR=_F(METHODE="MUMPS"))
TP = CALC_CHAMP(reuse=TP, RESULTAT=TP, GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "CHEVETRES", "LONGRINES", "PILES"), CONTRAINTE=("EFGE_ELNO",))
TP = CALC_CHAMP(reuse=TP, RESULTAT=TP, FORCE=("REAC_NODA",))
# T− = −28 °C, tout l'aluminium
T_TM = CREA_CHAMP(OPERATION="AFFE", TYPE_CHAM="NOEU_TEMP_R", MAILLAGE=MAIL, AFFE=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC"), NOM_CMP="TEMP", VALE=-28.0))
M_TM = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC"), MATER=ALU), _F(GROUP_MA=("CHEVETRES", "LONGRINES", "PILES", "SEMELLE"), MATER=BETON)),
    AFFE_VARC=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC"), NOM_VARC="TEMP", CHAM_GD=T_TM, VALE_REF=0.0),
)
TM = MECA_STATIQUE(MODELE=MODELE, CHAM_MATER=M_TM, CARA_ELEM=CARA, EXCIT=_F(CHARGE=CL), SOLVEUR=_F(METHODE="MUMPS"))
TM = CALC_CHAMP(reuse=TM, RESULTAT=TM, GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "CHEVETRES", "LONGRINES", "PILES"), CONTRAINTE=("EFGE_ELNO",))
TM = CALC_CHAMP(reuse=TM, RESULTAT=TM, FORCE=("REAC_NODA",))
# TA+ = +56 °C, poutres, montants, diagonales (S2)
T_TAP = CREA_CHAMP(OPERATION="AFFE", TYPE_CHAM="NOEU_TEMP_R", MAILLAGE=MAIL, AFFE=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES"), NOM_CMP="TEMP", VALE=56.0))
M_TAP = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC"), MATER=ALU), _F(GROUP_MA=("CHEVETRES", "LONGRINES", "PILES", "SEMELLE"), MATER=BETON)),
    AFFE_VARC=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES"), NOM_VARC="TEMP", CHAM_GD=T_TAP, VALE_REF=0.0),
)
TAP = MECA_STATIQUE(MODELE=MODELE, CHAM_MATER=M_TAP, CARA_ELEM=CARA, EXCIT=_F(CHARGE=CL), SOLVEUR=_F(METHODE="MUMPS"))
TAP = CALC_CHAMP(reuse=TAP, RESULTAT=TAP, GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "CHEVETRES", "LONGRINES", "PILES"), CONTRAINTE=("EFGE_ELNO",))
TAP = CALC_CHAMP(reuse=TAP, RESULTAT=TAP, FORCE=("REAC_NODA",))
# TA− = −23 °C, poutres, montants, diagonales (S2)
T_TAM = CREA_CHAMP(OPERATION="AFFE", TYPE_CHAM="NOEU_TEMP_R", MAILLAGE=MAIL, AFFE=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES"), NOM_CMP="TEMP", VALE=-23.0))
M_TAM = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC"), MATER=ALU), _F(GROUP_MA=("CHEVETRES", "LONGRINES", "PILES", "SEMELLE"), MATER=BETON)),
    AFFE_VARC=_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES"), NOM_VARC="TEMP", CHAM_GD=T_TAM, VALE_REF=0.0),
)
TAM = MECA_STATIQUE(MODELE=MODELE, CHAM_MATER=M_TAM, CARA_ELEM=CARA, EXCIT=_F(CHARGE=CL), SOLVEUR=_F(METHODE="MUMPS"))
TAM = CALC_CHAMP(reuse=TAM, RESULTAT=TAM, GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "CHEVETRES", "LONGRINES", "PILES"), CONTRAINTE=("EFGE_ELNO",))
TAM = CALC_CHAMP(reuse=TAM, RESULTAT=TAM, FORCE=("REAC_NODA",))

# ---------------------------------------------------------------- 8. SORTIES
