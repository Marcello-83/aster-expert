# PONTONS-ALU-01, lot 51 bis : palée type (4 piles, anneau BA), trois travées en
# aluminium soudé rehaussées de 0,50 m, appuis articulés à axe. Calcul linéaire,
# cas élémentaires unitaires.
# Variante H80P : anneau h = 0,80 m, palée profonde, hauteur libre 3,90 m, tube 200 × 200 × 8.
# Code_Aster 17.4. Unités : m, N, Pa, °C. Maillage : maillage_palee_51bis.med (maillage_palee_51bis.py,
# H_ANNEAU = 0.8 m, H_PILES = 3.9 m). Généré par pontons_alu_01.generation_lot51bis
# à partir de la fiche (P1 à P51), des données et de variantes_lot51bis.yaml : régénérer
# plutôt qu'éditer. Combinaisons et exports : post-traitement (scripts/lot51bis.py).
#
# Paramètres et cotes (rappel, m NGF)
#   travées T1 et T2 de 6.25 m, petite travée entre chevêtres en X = 6.25 et 7.77 ;
#   B = 1.86 m, tablier 2.0 m (P35) ; plan moyen +1.858, pannes +1.958, sous-face des poutres +1.758 (P47)
#   axe d'appui +1.588, dessus des chevêtres +1.488, axe de l'anneau 1.088, têtes de piles 0.688, dessus de la semelle -3.212
#   poutres principales tube 200 × 200 × 8 mm (P36) ; anneau 0.4 × 0.8 m (P48) ; piles Ø 0.5 m, hauteur libre 3.9 m, 4 têtes encastrées (P46)
#   semelle 2.60 × 2.60 × 0.2 m (P48) ; sol kn = 5e+06 N/m³, kt = 1e+06 N/m³ (P19)

DEBUT(CODE="OUI")

# ---------------------------------------------------------------- 1. MAILLAGE
MAIL0 = LIRE_MAILLAGE(FORMAT="MED", UNITE=20)
# Appui élastique réparti (P19) : une maille POI1 par nœud de la semelle (ssls135a).
MAIL = CREA_MAILLAGE(MAILLAGE=MAIL0, CREA_POI1=_F(NOM_GROUP_MA="SOL", GROUP_MA="SEMELLE"))
MAIL = DEFI_GROUP(reuse=MAIL, MAILLAGE=MAIL, CREA_GROUP_NO=_F(GROUP_MA="SEMELLE", NOM="N_SEMELLE"))

# ---------------------------------------------------------------- 2. MODÈLE
# Barres : POU_D_T ; semelle : DKT ; sol : DIS_T (P19).
MODELE = AFFE_MODELE(
    MAILLAGE=MAIL,
    AFFE=(
        _F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "CHEVETRES", "LONGRINES", "PILES"), PHENOMENE="MECANIQUE", MODELISATION="POU_D_T"),
        _F(GROUP_MA="SEMELLE", PHENOMENE="MECANIQUE", MODELISATION="DKT"),
        _F(GROUP_MA="SOL", PHENOMENE="MECANIQUE", MODELISATION="DIS_T"),
    ),
)

# ---------------------------------------------------------------- 3. MATÉRIAUX
# RHO = γ / g (CA-048). Températures : aluminium seulement (P10).
ALU = DEFI_MATERIAU(ELAS=_F(E=70000000000.0, NU=0.3, RHO=2752.293577981651, ALPHA=2.3e-05))
BETON = DEFI_MATERIAU(ELAS=_F(E=34000000000.0, NU=0.2, RHO=2548.41997961264))
CHMAT = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(_F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC"), MATER=ALU), _F(GROUP_MA=("CHEVETRES", "LONGRINES", "PILES", "SEMELLE"), MATER=BETON)),
)

# ---------------------------------------------------------------- 4. CARACTÉRISTIQUES
# Tubes carrés à angles vifs : A, I et JX (Bredt) calculés par Code_Aster (U4.42.01).
# Repère local : z_l = +Z pour les barres horizontales (VECT_Z), y_l = +X pour les piles.
CARA = AFFE_CARA_ELEM(
    MODELE=MODELE,
    POUTRE=(
        _F(GROUP_MA="POUTRES_PRINC", SECTION="RECTANGLE", CARA=("H", "EP"), VALE=(0.2, 0.008)),
        _F(GROUP_MA=("MONTANTS", "DIAGONALES"), SECTION="RECTANGLE", CARA=("H", "EP"), VALE=(0.15, 0.007)),
        _F(GROUP_MA="PANNES_SEC", SECTION="RECTANGLE", CARA=("H", "EP"), VALE=(0.05, 0.005)),
        _F(GROUP_MA=("CHEVETRES", "LONGRINES"), SECTION="RECTANGLE", CARA=("HY", "HZ"), VALE=(0.4, 0.8)),
        _F(GROUP_MA="PILES", SECTION="CERCLE", CARA=("R",), VALE=(0.25,)),
    ),
    ORIENTATION=(
        _F(GROUP_MA=("POUTRES_PRINC", "MONTANTS", "DIAGONALES", "PANNES_SEC", "CHEVETRES", "LONGRINES"), CARA="VECT_Z", VALE=(0.0, 0.0, 1.0)),
        _F(GROUP_MA="PILES", CARA="VECT_Y", VALE=(1.0, 0.0, 0.0)),
    ),
    COQUE=_F(GROUP_MA="SEMELLE", EPAIS=0.2, ANGL_REP=(0.0, 0.0)),
    DISCRET=_F(GROUP_MA="SOL", CARA="M_T_D_N", VALE=0.0),
    # P19 : raideurs globales k × surface, réparties au prorata des surfaces (U4.42.01).
    RIGI_PARASOL=_F(
        GROUP_MA="SEMELLE", GROUP_MA_POI1="SOL", COEF_GROUP=1.0, CARA="K_T_D_N",
        VALE=(6760000.000000002, 6760000.000000002, 33800000.00000001),
        COOR_CENTRE=(7.01, 0.0, -3.312),
    ),
)

# ---------------------------------------------------------------- 5. LIAISONS ET APPUIS
# P35, P45 : rotule côté quai Y > 0 fixe (X, Y, Z), rotule Y < 0 guidée (X, Z) : seul
# point fixe en X de la chaîne des travées. LIAISON_SOLIDE : pannes / montants et
# diagonales (LR_), tête de pile encastrée dans le chevêtre (TP_, P46), angle de
# l'anneau monolithique (LG_), pied de pile / semelle (PS_).
# P44, appuis à axe (axe parallèle à Y, point P non maillé) : LIAISON_DDL sur la
# translation de P portée par un nœud N, u_N + θ_N ∧ (P − N) ; oreilles des deux travées
# (AX_<appui>_<rive>_1 et _2) : translations de P égales et DRX égales ; oreille 1 et
# nœud du chevêtre (_K) : Z égal, et Y égal en YP ; X libre (trou oblong). A3 (X = 14,02) :
# support fixe, Z de P nul, et Y nul en YP.
CL = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=(_F(GROUP_NO="APP_QUAI_YP", DX=0.0, DY=0.0, DZ=0.0), _F(GROUP_NO="APP_QUAI_YM", DX=0.0, DZ=0.0)),
