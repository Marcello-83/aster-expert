# Cas mécaniques : une factorisation (MACRO_ELAS_MULT, CA-055) ; un cas total = somme
# des charges de ses travées.
ELEM = MACRO_ELAS_MULT(
    MODELE=MODELE,
    CHAM_MATER=CHMAT,
    CARA_ELEM=CARA,
    CHAR_MECA_GLOBAL=CL,
    CAS_CHARGE=(
        _F(NOM_CAS="G1", CHAR_MECA=CG1, OPTION="SANS"),
        _F(NOM_CAS="DEJ", CHAR_MECA=CDEJ, OPTION="SANS"),
