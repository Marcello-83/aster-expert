# E10 : TEP, ΔT = +27.5 °C sur la dalle (PREP_VARC) et les chevêtres (TEMP), CA-054.
T_TEP_C = CREA_CHAMP(
    OPERATION="AFFE",
    TYPE_CHAM="NOEU_TEMP_R",
    MAILLAGE=MAILR,
    AFFE=_F(GROUP_MA="DALLE", NOM_CMP=("TEMP_MIL", "TEMP_INF", "TEMP_SUP"), VALE=(27.5, 27.5, 27.5)),
)
R_TEP_C = CREA_RESU(OPERATION="AFFE", TYPE_RESU="EVOL_THER", AFFE=_F(NOM_CHAM="TEMP", CHAM_GD=T_TEP_C, INST=0.0))
P_TEP_C = CREA_RESU(
    OPERATION="PREP_VARC",
    TYPE_RESU="EVOL_THER",
    PREP_VARC=_F(MODELE=MODELE, CARA_ELEM=CARA, EVOL_THER=R_TEP_C, GROUP_MA="DALLE"),
)
T_TEP_P = CREA_CHAMP(
    OPERATION="AFFE",
    TYPE_CHAM="NOEU_TEMP_R",
    MAILLAGE=MAILR,
    AFFE=_F(GROUP_MA="CHEVETRES", NOM_CMP="TEMP", VALE=27.5),
)
M_TEP = AFFE_MATERIAU(
    MAILLAGE=MAILR,
    AFFE=(
        _F(GROUP_MA=("DALLE", "CHEVETRES"), MATER=BETON),
        _F(GROUP_MA=("PIEUX",), MATER=ACIER),
    ),
    AFFE_VARC=(
        _F(GROUP_MA="DALLE", NOM_VARC="TEMP", EVOL=P_TEP_C, NOM_CHAM="TEMP", VALE_REF=0.0),
        _F(GROUP_MA="CHEVETRES", NOM_VARC="TEMP", CHAM_GD=T_TEP_P, VALE_REF=0.0),
    ),
)
TEP = MECA_STATIQUE(MODELE=MODELE, CHAM_MATER=M_TEP, CARA_ELEM=CARA, EXCIT=_F(CHARGE=CL))

# E10 : TEM, ΔT = -27.5 °C sur la dalle (PREP_VARC) et les chevêtres (TEMP), CA-054.
T_TEM_C = CREA_CHAMP(
    OPERATION="AFFE",
    TYPE_CHAM="NOEU_TEMP_R",
    MAILLAGE=MAILR,
    AFFE=_F(GROUP_MA="DALLE", NOM_CMP=("TEMP_MIL", "TEMP_INF", "TEMP_SUP"), VALE=(-27.5, -27.5, -27.5)),
)
R_TEM_C = CREA_RESU(OPERATION="AFFE", TYPE_RESU="EVOL_THER", AFFE=_F(NOM_CHAM="TEMP", CHAM_GD=T_TEM_C, INST=0.0))
P_TEM_C = CREA_RESU(
    OPERATION="PREP_VARC",
    TYPE_RESU="EVOL_THER",
    PREP_VARC=_F(MODELE=MODELE, CARA_ELEM=CARA, EVOL_THER=R_TEM_C, GROUP_MA="DALLE"),
)
T_TEM_P = CREA_CHAMP(
    OPERATION="AFFE",
    TYPE_CHAM="NOEU_TEMP_R",
    MAILLAGE=MAILR,
    AFFE=_F(GROUP_MA="CHEVETRES", NOM_CMP="TEMP", VALE=-27.5),
)
M_TEM = AFFE_MATERIAU(
    MAILLAGE=MAILR,
    AFFE=(
        _F(GROUP_MA=("DALLE", "CHEVETRES"), MATER=BETON),
        _F(GROUP_MA=("PIEUX",), MATER=ACIER),
    ),
    AFFE_VARC=(
        _F(GROUP_MA="DALLE", NOM_VARC="TEMP", EVOL=P_TEM_C, NOM_CHAM="TEMP", VALE_REF=0.0),
        _F(GROUP_MA="CHEVETRES", NOM_VARC="TEMP", CHAM_GD=T_TEM_P, VALE_REF=0.0),
    ),
)
TEM = MECA_STATIQUE(MODELE=MODELE, CHAM_MATER=M_TEM, CARA_ELEM=CARA, EXCIT=_F(CHARGE=CL))
TEP = CALC_CHAMP(reuse=TEP, RESULTAT=TEP, GROUP_MA="DALLE", CONTRAINTE=("EFGE_NOEU",))
TEP = CALC_CHAMP(reuse=TEP, RESULTAT=TEP, GROUP_MA=("CHEVETRES", "PIEUX"), CONTRAINTE=("EFGE_ELNO",))
TEP = CALC_CHAMP(reuse=TEP, RESULTAT=TEP, FORCE=("REAC_NODA",))
IMPR_RESU(
    FORMAT="MED",
    UNITE=80,
    RESU=(
        _F(RESULTAT=TEP, NOM_RESU_MED="TEP", NOM_CHAM="DEPL", NOM_CMP=("DX", "DY", "DZ"), CARA_ELEM=CARA),
        _F(RESULTAT=TEP, NOM_RESU_MED="TEP", NOM_CHAM="EFGE_NOEU", NOM_CMP=("NXX", "NYY", "MXX", "MYY", "MXY", "QX", "QY"), GROUP_MA="DALLE", CARA_ELEM=CARA),
        _F(RESULTAT=TEP, NOM_RESU_MED="TEP", NOM_CHAM="EFGE_ELNO", GROUP_MA=("CHEVETRES", "PIEUX"), CARA_ELEM=CARA),
    ),
)
T_RP_TEP = POST_RELEVE_T(
    ACTION=_F(OPERATION="EXTRACTION", INTITULE="RP_TEP", RESULTAT=TEP, NOM_CHAM="REAC_NODA", TOUT_ORDRE="OUI", GROUP_NO=("PIEDS",), RESULTANTE=("DX", "DY", "DZ"))
)
IMPR_TABLE(TABLE=T_RP_TEP, UNITE=6, FORMAT_R="E20.12")
T_DR_TEP = POST_RELEVE_T(
    ACTION=_F(OPERATION="EXTRACTION", INTITULE="DR_TEP", RESULTAT=TEP, NOM_CHAM="DEPL", TOUT_ORDRE="OUI", GROUP_NO=("RESSORTS",), NOM_CMP=("DX", "DY"))
)
IMPR_TABLE(TABLE=T_DR_TEP, UNITE=6, FORMAT_R="E20.12")
T_SY_TEP = POST_RELEVE_T(
    ACTION=_F(OPERATION="EXTRACTION", INTITULE="SYMETRIE_TEP", RESULTAT=TEP, NOM_CHAM="DEPL", TOUT_ORDRE="OUI", GROUP_NO=("SYM_NOEUDS",), NOM_CMP=("DX", "DY", "DZ"))
)
IMPR_TABLE(TABLE=T_SY_TEP, UNITE=6, FORMAT_R="E20.12")
TEM = CALC_CHAMP(reuse=TEM, RESULTAT=TEM, GROUP_MA="DALLE", CONTRAINTE=("EFGE_NOEU",))
TEM = CALC_CHAMP(reuse=TEM, RESULTAT=TEM, GROUP_MA=("CHEVETRES", "PIEUX"), CONTRAINTE=("EFGE_ELNO",))
TEM = CALC_CHAMP(reuse=TEM, RESULTAT=TEM, FORCE=("REAC_NODA",))
IMPR_RESU(
    FORMAT="MED",
    UNITE=80,
    RESU=(
        _F(RESULTAT=TEM, NOM_RESU_MED="TEM", NOM_CHAM="DEPL", NOM_CMP=("DX", "DY", "DZ"), CARA_ELEM=CARA),
        _F(RESULTAT=TEM, NOM_RESU_MED="TEM", NOM_CHAM="EFGE_NOEU", NOM_CMP=("NXX", "NYY", "MXX", "MYY", "MXY", "QX", "QY"), GROUP_MA="DALLE", CARA_ELEM=CARA),
        _F(RESULTAT=TEM, NOM_RESU_MED="TEM", NOM_CHAM="EFGE_ELNO", GROUP_MA=("CHEVETRES", "PIEUX"), CARA_ELEM=CARA),
    ),
)
T_RP_TEM = POST_RELEVE_T(
    ACTION=_F(OPERATION="EXTRACTION", INTITULE="RP_TEM", RESULTAT=TEM, NOM_CHAM="REAC_NODA", TOUT_ORDRE="OUI", GROUP_NO=("PIEDS",), RESULTANTE=("DX", "DY", "DZ"))
)
IMPR_TABLE(TABLE=T_RP_TEM, UNITE=6, FORMAT_R="E20.12")
T_DR_TEM = POST_RELEVE_T(
    ACTION=_F(OPERATION="EXTRACTION", INTITULE="DR_TEM", RESULTAT=TEM, NOM_CHAM="DEPL", TOUT_ORDRE="OUI", GROUP_NO=("RESSORTS",), NOM_CMP=("DX", "DY"))
)
IMPR_TABLE(TABLE=T_DR_TEM, UNITE=6, FORMAT_R="E20.12")
T_SY_TEM = POST_RELEVE_T(
    ACTION=_F(OPERATION="EXTRACTION", INTITULE="SYMETRIE_TEM", RESULTAT=TEM, NOM_CHAM="DEPL", TOUT_ORDRE="OUI", GROUP_NO=("SYM_NOEUDS",), NOM_CMP=("DX", "DY", "DZ"))
)
IMPR_TABLE(TABLE=T_SY_TEM, UNITE=6, FORMAT_R="E20.12")

FIN()
