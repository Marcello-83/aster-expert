# Estacade ESTACADE-PIEUX-01 (lot 47) -- maillage estacade_pieux_01.mmed, mode production, variante chevetre_0p80.
# Contre-calcul d'un modèle non validé. Généré par estacade_pieux_01.generation à
# partir de la fiche (fiche/hypotheses_estacade_pieux_01.json) et des données
# (donnees/estacade_pieux_01_model_data.yaml) : ne pas éditer. Unités m, N, Pa (U1).

DEBUT(CODE="OUI")

MAIL = LIRE_MAILLAGE(FORMAT="MED", UNITE=20)

# CA-028, CA-045 : normales de la dalle +Z, MXX > 0 tend la face supérieure.
MAIL = MODI_MAILLAGE(
    reuse=MAIL,
    MAILLAGE=MAIL,
    ORIE_NORM_COQUE=_F(GROUP_MA=("DALLE",), VECT_NORM=(0.0, 0.0, 1.0), GROUP_NO="COIN_ABOUT"),
)
MAIL = DEFI_GROUP(reuse=MAIL, MAILLAGE=MAIL, CREA_GROUP_NO=_F(UNION=("KR_P100", "KR_P050", "KR_P000", "KR_M050", "KR_M100", "KR_M150", "KR_M200", "KR_M250", "KR_M300", "KR_M350", "KR_M400", "KR_M450", "KR_M500", "KR_M550", "KR_M600", "KR_M650", "KR_M700", "KR_M750", "KR_M800", "KR_M850", "KR_M900", "KR_M950", "KR_M1000", "KR_M1050", "KR_M1100", "KR_M1150", "KR_M1200", "KR_M1250", "KR_M1300", "KE_M200", "KE_M250", "KE_M300", "KE_M350", "KE_M400", "KE_M450", "KE_M500", "KE_M550", "KE_M600", "KE_M650", "KE_M700", "KE_M750", "KE_M800", "KE_M850", "KE_M900", "KE_M950", "KE_M1000", "KE_M1050", "KE_M1100", "KE_M1150", "KE_M1200", "KE_M1250", "KE_M1300",), NOM="RESSORTS"))

# Ensemble symétrique de nœuds pour CTL-006 : un groupe par GROUP_MA puis UNION
# (DIAG-010).
MAIL = DEFI_GROUP(
    reuse=MAIL,
    MAILLAGE=MAIL,
    CREA_GROUP_NO=(
        _F(GROUP_MA="PIEUX", NOM="SYMN_PIEUX"),
        _F(GROUP_MA="CHEVETRES", NOM="SYMN_CHEVETRES"),
        _F(GROUP_MA="RIVE_YM", NOM="SYMN_RIVE_YM"),
        _F(GROUP_MA="RIVE_YP", NOM="SYMN_RIVE_YP"),
    ),
)
MAIL = DEFI_GROUP(
    reuse=MAIL,
    MAILLAGE=MAIL,
    CREA_GROUP_NO=_F(UNION=("SYMN_PIEUX", "SYMN_CHEVETRES", "SYMN_RIVE_YM", "SYMN_RIVE_YP",), NOM="SYM_NOEUDS"),
)

