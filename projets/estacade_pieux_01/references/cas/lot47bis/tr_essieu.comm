    ),
)

# E13 : dalle DKT, chevêtres POU_D_T, pieux POU_D_T ; arêtes de rive en DKT pour
# FORCE_ARETE (CA-056) ; ressorts DIS_T.
MODELE = AFFE_MODELE(
    MAILLAGE=MAILR,
    AFFE=(
        _F(GROUP_MA=("DALLE", "RIVE_YM", "RIVE_YP"), PHENOMENE="MECANIQUE", MODELISATION="DKT"),
        _F(GROUP_MA=("CHEVETRES",), PHENOMENE="MECANIQUE", MODELISATION="POU_D_T"),
        _F(GROUP_MA=("PIEUX",), PHENOMENE="MECANIQUE", MODELISATION="POU_D_T"),
        _F(GROUP_MA=("RESS_K00900", "RESS_K02400", "RESS_K03000", "RESS_K03400", "RESS_K03500", "RESS_K08300", "RESS_K09700", "RESS_K10600", "RESS_K11000", "RESS_K12300", "RESS_K13600", "RESS_K14000", "RESS_K21200",), PHENOMENE="MECANIQUE", MODELISATION="DIS_T"),
    ),
)

# E7, E10 : béton Ecm = 3.4e+10 Pa, ν = 0.2, RHO = γ / g ;
# acier 2.1e+11 Pa, ν = 0.3 ; α du béton (dalle et chevêtres).
BETON = DEFI_MATERIAU(
    ELAS=_F(E=34000000000.0, NU=0.2, RHO=2548.41997961264, ALPHA=1e-05)
)
ACIER = DEFI_MATERIAU(
    ELAS=_F(E=210000000000.0, NU=0.3, RHO=8002.03873598369)
)
CHMAT = AFFE_MATERIAU(
    MAILLAGE=MAILR,
    AFFE=(
        _F(GROUP_MA=("DALLE", "CHEVETRES"), MATER=BETON),
        _F(GROUP_MA=("PIEUX",), MATER=ACIER),
    ),
)

# Sections : dalle EPAIS, x_l = X (ANGL_REP) ; chevêtre rectangle 1.2 (selon X)
# × 0.9 (selon Z), y_l = −X donc z_l vertical (E2) ; pieux, tube équivalent
# à A et I de chaque tronçon de B2 (CA-057), y_l = X ; ressorts (k, k, 0), masse nulle
# (DIAG-004).
CARA = AFFE_CARA_ELEM(
    MODELE=MODELE,
    COQUE=_F(GROUP_MA="DALLE", EPAIS=0.4, ANGL_REP=(0.0, 0.0)),
