        _F(NOM_CAS="TRE_M04", CHAR_MECA=CH_TRE_M04, OPTION="SANS"),
    ),
    SOLVEUR=_F(METHODE="MUMPS", POSTTRAITEMENTS="FORCE"),
)
MB01 = CALC_CHAMP(reuse=MB01, RESULTAT=MB01, GROUP_MA="DALLE", CONTRAINTE=("EFGE_NOEU",))
MB01 = CALC_CHAMP(reuse=MB01, RESULTAT=MB01, GROUP_MA=("CHEVETRES", "PIEUX"), CONTRAINTE=("EFGE_ELNO",))
MB01 = CALC_CHAMP(reuse=MB01, RESULTAT=MB01, FORCE=("REAC_NODA",))
IMPR_RESU(
    FORMAT="MED",
    UNITE=80,
    RESU=(
        _F(RESULTAT=MB01, NOM_RESU_MED="MB01", NOM_CHAM="DEPL", NOM_CMP=("DX", "DY", "DZ"), CARA_ELEM=CARA),
        _F(RESULTAT=MB01, NOM_RESU_MED="MB01", NOM_CHAM="EFGE_NOEU", NOM_CMP=("NXX", "NYY", "MXX", "MYY", "MXY", "QX", "QY"), GROUP_MA="DALLE", CARA_ELEM=CARA),
        _F(RESULTAT=MB01, NOM_RESU_MED="MB01", NOM_CHAM="EFGE_ELNO", GROUP_MA=("CHEVETRES", "PIEUX"), CARA_ELEM=CARA),
    ),
)
T_RA_MB01 = POST_RELEVE_T(
