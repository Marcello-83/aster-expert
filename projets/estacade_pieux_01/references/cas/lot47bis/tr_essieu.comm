# Lot 1 : 25 cas, une factorisation (CA-055), sans SIEF_ELGA stocké.
MB01 = MACRO_ELAS_MULT(
    MODELE=MODELE,
    CHAM_MATER=CHMAT,
    CARA_ELEM=CARA,
    CHAR_MECA_GLOBAL=CL,
    CAS_CHARGE=(
        _F(NOM_CAS="TRE_M28", CHAR_MECA=CH_TRE_M28, OPTION="SANS"),
        _F(NOM_CAS="TRE_M27", CHAR_MECA=CH_TRE_M27, OPTION="SANS"),
        _F(NOM_CAS="TRE_M26", CHAR_MECA=CH_TRE_M26, OPTION="SANS"),
