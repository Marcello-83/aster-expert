        _F(NOM_CAS="TRE_M12", CHAR_MECA=CH_TRE_M12, OPTION="SANS"),
        _F(NOM_CAS="TRE_M11", CHAR_MECA=CH_TRE_M11, OPTION="SANS"),
        _F(NOM_CAS="TRE_M10", CHAR_MECA=CH_TRE_M10, OPTION="SANS"),
        _F(NOM_CAS="TRE_M09", CHAR_MECA=CH_TRE_M09, OPTION="SANS"),
