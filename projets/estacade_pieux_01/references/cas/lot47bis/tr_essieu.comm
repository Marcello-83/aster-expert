        _F(NOM_GROUP_MA="RESS_K03500", GROUP_NO=('KR_P100',)),
        _F(NOM_GROUP_MA="RESS_K08300", GROUP_NO=('KR_P050',)),
        _F(NOM_GROUP_MA="RESS_K09700", GROUP_NO=('KR_P000',)),
        _F(NOM_GROUP_MA="RESS_K10600", GROUP_NO=('KR_M1300', 'KE_M1300',)),
        _F(NOM_GROUP_MA="RESS_K11000", GROUP_NO=('KR_M050',)),
        _F(NOM_GROUP_MA="RESS_K12300", GROUP_NO=('KR_M100',)),
        _F(NOM_GROUP_MA="RESS_K13600", GROUP_NO=('KR_M150',)),
        _F(NOM_GROUP_MA="RESS_K14000", GROUP_NO=('KR_M200', 'KR_M250',)),
