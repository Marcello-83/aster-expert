# Sonde du lot 47 (estacade_pieux_01) : température coque + poutre, MACRO_ELAS_MULT,
# FORCE_ARETE sur arête de DKT, section CERCLE, ressort DIS_T sans masse sous PESANTEUR.
# Généré par projets/estacade_pieux_01/scripts/sonde_lot47.py : ne pas éditer.

DEBUT(CODE="OUI")

MAIL = LIRE_MAILLAGE(FORMAT="ASTER", UNITE=20)

MODELE = AFFE_MODELE(
    MAILLAGE=MAIL,
    AFFE=(
        _F(GROUP_MA=("DALLE", "RIVE"), PHENOMENE="MECANIQUE", MODELISATION="DKT"),
        _F(GROUP_MA=("CHEV", "PIEU"), PHENOMENE="MECANIQUE", MODELISATION="POU_D_T"),
        _F(GROUP_MA=("RESS",), PHENOMENE="MECANIQUE", MODELISATION="DIS_T"),
    ),
)

BETON = DEFI_MATERIAU(ELAS=_F(E=34000000000.0, NU=0.2, RHO=2548.41997961264, ALPHA=1e-05))
ACIER = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.3, RHO=8002.03873598369, ALPHA=1e-05))

CARA = AFFE_CARA_ELEM(
    MODELE=MODELE,
    COQUE=_F(GROUP_MA="DALLE", EPAIS=0.4, ANGL_REP=(0.0, 0.0)),
    POUTRE=(
        _F(GROUP_MA="CHEV", SECTION="RECTANGLE", CARA=("HY", "HZ"), VALE=(1.2, 0.9)),
        _F(GROUP_MA="PIEU", SECTION="CERCLE", CARA=("R", "EP"), VALE=(0.3262510393364011, 0.015249849880651888)),
    ),
    ORIENTATION=(
        _F(GROUP_MA="CHEV", CARA="VECT_Y", VALE=(-1.0, 0.0, 0.0)),
        _F(GROUP_MA="PIEU", CARA="VECT_Y", VALE=(1.0, 0.0, 0.0)),
    ),
    DISCRET=(
        _F(GROUP_MA="RESS", CARA="K_T_D_N", REPERE="GLOBAL", VALE=(3500000.0, 3500000.0, 0.0)),
        _F(GROUP_MA="RESS", CARA="M_T_D_N", VALE=(0.0,)),
    ),
)

CHMAT = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(_F(GROUP_MA=("DALLE", "CHEV"), MATER=BETON), _F(GROUP_MA="PIEU", MATER=ACIER)),
)

CL = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=(
        _F(GROUP_NO="P0", DX=0.0, DY=0.0, DZ=0.0),
        _F(GROUP_NO="Q", DY=0.0, DZ=0.0),
        _F(GROUP_NO="R", DZ=0.0),
    ),
)

# T1 : température uniforme sur la plaque (PREP_VARC, comme hsls01a) et sur le
# chevêtre (CHAM_GD TEMP, comme ssll12a) ; le pieu n'en reçoit pas.
T_COQ = CREA_CHAMP(
    OPERATION="AFFE",
    TYPE_CHAM="NOEU_TEMP_R",
    MAILLAGE=MAIL,
    AFFE=_F(GROUP_MA="DALLE", NOM_CMP=("TEMP_MIL", "TEMP_INF", "TEMP_SUP"), VALE=(27.5, 27.5, 27.5)),
)
T_COQ_R = CREA_RESU(
    OPERATION="AFFE", TYPE_RESU="EVOL_THER", AFFE=_F(NOM_CHAM="TEMP", CHAM_GD=T_COQ, INST=0.0)
)
T_COQ_P = CREA_RESU(
    OPERATION="PREP_VARC",
    TYPE_RESU="EVOL_THER",
    PREP_VARC=_F(MODELE=MODELE, CARA_ELEM=CARA, EVOL_THER=T_COQ_R, GROUP_MA="DALLE"),
)
T_POU = CREA_CHAMP(
    OPERATION="AFFE",
    TYPE_CHAM="NOEU_TEMP_R",
    MAILLAGE=MAIL,
    AFFE=_F(GROUP_MA="CHEV", NOM_CMP="TEMP", VALE=27.5),
)
CHMAT_T = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(_F(GROUP_MA=("DALLE", "CHEV"), MATER=BETON), _F(GROUP_MA="PIEU", MATER=ACIER)),
    AFFE_VARC=(
        _F(GROUP_MA="DALLE", NOM_VARC="TEMP", EVOL=T_COQ_P, NOM_CHAM="TEMP", VALE_REF=0.0),
        _F(GROUP_MA="CHEV", NOM_VARC="TEMP", CHAM_GD=T_POU, VALE_REF=0.0),
    ),
)
RESU_T = MECA_STATIQUE(MODELE=MODELE, CHAM_MATER=CHMAT_T, CARA_ELEM=CARA, EXCIT=_F(CHARGE=CL))
RESU_T = CALC_CHAMP(
    reuse=RESU_T, RESULTAT=RESU_T, CONTRAINTE=("EFGE_ELNO", "EFGE_NOEU"), FORCE=("REAC_NODA",)
)
T_T1D = POST_RELEVE_T(
    ACTION=_F(
        OPERATION="EXTRACTION",
        INTITULE="T1_DEPL",
        RESULTAT=RESU_T,
        NOM_CHAM="DEPL",
        TOUT_ORDRE="OUI",
        GROUP_NO=("PLAQUE",),
        NOM_CMP=("DX", "DY", "DZ"),
    )
)
IMPR_TABLE(TABLE=T_T1D, UNITE=6, FORMAT_R="E20.12")
T_T1E = CREA_TABLE(
    RESU=_F(
        RESULTAT=RESU_T,
        NOM_CHAM="EFGE_ELNO",
        TOUT_ORDRE="OUI",
        NOM_CMP=("NXX", "NYY", "NXY", "MXX", "MYY"),
        GROUP_MA="DALLE",
    )
)
IMPR_TABLE(TABLE=T_T1E, UNITE=6, FORMAT_R="E20.12", TITRE="T1_EFGE_DALLE")
T_T1C = CREA_TABLE(
    RESU=_F(
        RESULTAT=RESU_T,
        NOM_CHAM="EFGE_ELNO",
        TOUT_ORDRE="OUI",
        NOM_CMP=("N", "VY", "VZ", "MT", "MFY", "MFZ"),
        GROUP_MA=("CHEV", "PIEU"),
    )
)
IMPR_TABLE(TABLE=T_T1C, UNITE=6, FORMAT_R="E20.12", TITRE="T1_EFGE_POUTRES")
T_T1R = POST_RELEVE_T(
    ACTION=_F(
        OPERATION="EXTRACTION",
        INTITULE="T1_REAC",
        RESULTAT=RESU_T,
        NOM_CHAM="REAC_NODA",
        TOUT_ORDRE="OUI",
        GROUP_NO=("APPUIS",),
        RESULTANTE=("DX", "DY", "DZ"),
    )
)
IMPR_TABLE(TABLE=T_T1R, UNITE=6, FORMAT_R="E20.12")

# T2 : MACRO_ELAS_MULT, une factorisation pour quatre cas.
CH_PP = AFFE_CHAR_MECA(MODELE=MODELE, PESANTEUR=_F(GRAVITE=9.81, DIRECTION=(0.0, 0.0, -1.0)))
CH_G2 = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_COQUE=_F(GROUP_MA="DALLE", FZ=-8080.0))
CH_FR = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_COQUE=_F(GROUP_MA="DALLE", FX=4070.0))
CH_GC = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_ARETE=_F(GROUP_MA="RIVE", FZ=-500.0))
MULT = MACRO_ELAS_MULT(
    MODELE=MODELE,
    CHAM_MATER=CHMAT,
    CARA_ELEM=CARA,
    CHAR_MECA_GLOBAL=CL,
    CAS_CHARGE=(
        _F(NOM_CAS="PP", CHAR_MECA=CH_PP),
        _F(NOM_CAS="G2", CHAR_MECA=CH_G2),
        _F(NOM_CAS="FR", CHAR_MECA=CH_FR),
        _F(NOM_CAS="GC", CHAR_MECA=CH_GC),
    ),
)
MULT = CALC_CHAMP(
    reuse=MULT, RESULTAT=MULT, CONTRAINTE=("EFGE_ELNO", "EFGE_NOEU"), FORCE=("REAC_NODA",)
)
T_T2R = POST_RELEVE_T(
    ACTION=_F(
        OPERATION="EXTRACTION",
        INTITULE="T2_REAC",
        RESULTAT=MULT,
        NOM_CHAM="REAC_NODA",
        TOUT_ORDRE="OUI",
        GROUP_NO=("APPUIS",),
        RESULTANTE=("DX", "DY", "DZ"),
    )
)
IMPR_TABLE(TABLE=T_T2R, UNITE=6, FORMAT_R="E20.12")
T_T2P = CREA_TABLE(
    RESU=_F(
        RESULTAT=MULT,
        NOM_CHAM="EFGE_ELNO",
        TOUT_ORDRE="OUI",
        NOM_CMP=("N", "VY", "VZ", "MT", "MFY", "MFZ"),
        GROUP_MA=("PIEU",),
    )
)
IMPR_TABLE(TABLE=T_T2P, UNITE=6, FORMAT_R="E20.12", TITRE="T2_EFGE_PIEU")

IMPR_RESU(
    FORMAT="MED",
    UNITE=80,
    RESU=(
        _F(RESULTAT=MULT, NOM_RESU_MED="MULT", NOM_CHAM=("DEPL", "EFGE_NOEU"), CARA_ELEM=CARA),
        _F(RESULTAT=RESU_T, NOM_RESU_MED="TEMP", NOM_CHAM=("DEPL",), CARA_ELEM=CARA),
    ),
)

FIN()
