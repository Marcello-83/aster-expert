IMPR_TABLE(TABLE=T_ND_Q, UNITE=6, FORMAT_R="E20.12", TITRE="EFN_DALLE_Q")

# Point 13 : combinaisons (aster_expert.combinaisons.enumeration, γ et ψ des données).

# ELU_FOND_Q_DOM_G_defav (ELU fondamentale) : {'G': 1.35, 'Q': 1.5}
F_RC01_G = DEFI_CONSTANTE(VALE=1.35)
F_RC01_Q = DEFI_CONSTANTE(VALE=1.5)
RC01 = MECA_STATIQUE(
    MODELE=MODELE,
    CHAM_MATER=CHMAT,
    CARA_ELEM=CARA,
    EXCIT=(
        _F(CHARGE=CL),
        _F(CHARGE=CH_G, FONC_MULT=F_RC01_G),
        _F(CHARGE=CH_Q, FONC_MULT=F_RC01_Q),
