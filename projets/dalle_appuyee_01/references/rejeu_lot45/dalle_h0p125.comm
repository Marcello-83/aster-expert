IMPR_TABLE(TABLE=T_EFG03, UNITE=6, FORMAT_R="E20.12", TITRE="EFG03")

# Sensibilité demandée par MM : SIGC_*_ELS non contraignant (1e+09 Pa) sur
# la combinaison caractéristique ; densités identiques = limite de 0,6 fck inactive.

# ELS_CARA_Q_DOM (ELS caractéristique) : {'G': 1.0, 'Q': 1.0}
F_RSENS_G = DEFI_CONSTANTE(VALE=1.0)
F_RSENS_Q = DEFI_CONSTANTE(VALE=1.0)
RSENS = MECA_STATIQUE(
    MODELE=MODELE,
    CHAM_MATER=CHMAT,
    CARA_ELEM=CARA,
    EXCIT=(
        _F(CHARGE=CL),
        _F(CHARGE=CH_G, FONC_MULT=F_RSENS_G),
        _F(CHARGE=CH_Q, FONC_MULT=F_RSENS_Q),
    ),
)
RSENS = CALC_CHAMP(reuse=RSENS, RESULTAT=RSENS, CONTRAINTE=("EFGE_ELNO", "EFGE_NOEU"))
T_N_RSENS = CREA_TABLE(
    RESU=_F(
        RESULTAT=RSENS,
        NOM_CHAM="EFGE_NOEU",
        TOUT_ORDRE="OUI",
        NOM_CMP=("NXX", "NYY", "NXY", "MXX", "MYY", "MXY"),
        GROUP_NO="CENTRE",
    )
)
IMPR_TABLE(TABLE=T_N_RSENS, UNITE=6, FORMAT_R="E20.12", TITRE="EFN_C_RSENS")

# dalle appuyée : ELS_CARA_Q_DOM (ELS caractéristique, TYPE_COMB=ELS)
RSENS = CALC_FERRAILLAGE(
    reuse=RSENS,
    RESULTAT=RSENS,
    CARA_ELEM=CARA,
    CODIFICATION="EC2",
    TYPE_COMB="ELS",
    UNITE_CONTRAINTE="Pa",
    AFFE=(_F(
            GROUP_MA="DALLE",
            TYPE_STRUCTURE="2D",
            C_INF=0.048,
            C_SUP=0.048,
            FCK=30000000.0,
            FYK=500000000.0,
            EYS=200000000000.0,
            ALPHA_CC=1.0,
            SIGS_ELS=400000000.0,
            SIGC_INF_ELS=1000000000.0,
            SIGC_SUP_ELS=1000000000.0,
            ALPHA_E=15.0,
        ),),
)
T_SFER02 = CREA_TABLE(
    RESU=_F(
        RESULTAT=RSENS,
        NOM_CHAM="FERR_ELEM",
        TOUT_ORDRE="OUI",
        NOM_CMP=('DNSXI', 'DNSXS', 'DNSYI', 'DNSYS'),
        GROUP_MA="DALLE",
    )
)
IMPR_TABLE(TABLE=T_SFER02, UNITE=6, FORMAT_R="E20.12", TITRE="SFER02")
T_SEFG02 = CREA_TABLE(
    RESU=_F(
        RESULTAT=RSENS,
        NOM_CHAM="EFGE_ELNO",
        TOUT_ORDRE="OUI",
        NOM_CMP=('NXX', 'NYY', 'NXY', 'MXX', 'MYY', 'MXY'),
        GROUP_MA="CENTRE_V",
    )
)
IMPR_TABLE(TABLE=T_SEFG02, UNITE=6, FORMAT_R="E20.12", TITRE="SEFG02")

FIN()
