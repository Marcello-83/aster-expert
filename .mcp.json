{
  "mcpServers": {
    "aster-expert": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PROJECT_DIR:-.}",
        "--locked",
        "--all-extras",
        "--quiet",
        "aster-expert-mcp"
      ],
      "env": {
        "ASTER_EXPERT_ROOT": "${CLAUDE_PROJECT_DIR:-.}",
        "ASTER_CONTAINER_WORKROOT": "${CLAUDE_PROJECT_DIR:-.}/data/processed/workroot"
      }
    }
  }
}
