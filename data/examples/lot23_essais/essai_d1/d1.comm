# Essai D (lot 23), variante d1 -- reference, EPAIS = 0.01
# Bande console DKT, L = 2.0 m, b = 0.5 m, ELAS_COQUE de l'essai A,
# charge de bout q = 10.0 N/m, P = q b = 5.0 N.
# Par unite de largeur : M(x) = P (L - x) / b, Q = P / b.

DEBUT()

MAIL = LIRE_MAILLAGE(FORMAT="ASTER", UNITE=20)

MO = AFFE_MODELE(
    MAILLAGE=MAIL,
    AFFE=_F(TOUT="OUI", PHENOMENE="MECANIQUE", MODELISATION="DKT"),
)

CARA = AFFE_CARA_ELEM(MODELE=MO, COQUE=_F(GROUP_MA="PLAQUE", EPAIS=0.01, ANGL_REP=(0.0, 0.0)))

MAT = DEFI_MATERIAU(ELAS_COQUE=_F(MEMB_L=10000000.0, MEMB_LT=3000000.0, MEMB_T=10000000.0, MEMB_G_LT=3500000.0, FLEX_L=1000.0, FLEX_LT=0.0, FLEX_T=4000.0, FLEX_G_LT=500.0, CISA_L=10000000000.0, CISA_T=10000000000.0))

CHMAT = AFFE_MATERIAU(MAILLAGE=MAIL, AFFE=_F(GROUP_MA="PLAQUE", MATER=MAT))

CHAR = AFFE_CHAR_MECA(
    MODELE=MO,
    DDL_IMPO=_F(GROUP_NO="ENCASTR", DX=0.0, DY=0.0, DZ=0.0, DRX=0.0, DRY=0.0, DRZ=0.0),
    FORCE_ARETE=_F(GROUP_MA="BOUT", FZ=-10.0),
)

RESU = MECA_STATIQUE(MODELE=MO, CHAM_MATER=CHMAT, CARA_ELEM=CARA, EXCIT=_F(CHARGE=CHAR))

RESU = CALC_CHAMP(
    reuse=RESU,
    RESULTAT=RESU,
    CONTRAINTE=("EFGE_ELNO", "EFGE_NOEU"),
    FORCE=("FORC_NODA", "REAC_NODA"),
)

T_DEPL = CREA_TABLE(
    RESU=_F(RESULTAT=RESU, NOM_CHAM="DEPL", NUME_ORDRE=1, NOM_CMP=("DZ", "DRY"), GROUP_NO=("MILIEU", "BOUT"))
)

IMPR_TABLE(TABLE=T_DEPL, UNITE=6, FORMAT_R="E20.12")

T_EFGE_ELNO = CREA_TABLE(
    RESU=_F(RESULTAT=RESU, NOM_CHAM="EFGE_ELNO", NUME_ORDRE=1, NOM_CMP=("NXX", "NYY", "NXY", "MXX", "MYY", "MXY", "QX", "QY"), TOUT="OUI")
)

IMPR_TABLE(TABLE=T_EFGE_ELNO, UNITE=6, FORMAT_R="E20.12")

T_EFGE_NOEU = CREA_TABLE(
    RESU=_F(RESULTAT=RESU, NOM_CHAM="EFGE_NOEU", NUME_ORDRE=1, NOM_CMP=("NXX", "NYY", "NXY", "MXX", "MYY", "MXY", "QX", "QY"), TOUT="OUI")
)

IMPR_TABLE(TABLE=T_EFGE_NOEU, UNITE=6, FORMAT_R="E20.12")

IMPR_RESU(
    FORMAT="RESULTAT",
    UNITE=6,
    RESU=_F(RESULTAT=RESU, NOM_CHAM="SIEF_ELGA", NUME_ORDRE=1, NOM_CMP=("NXX", "NYY", "NXY", "MXX", "MYY", "MXY", "QX", "QY")),
)

T_REAC = POST_RELEVE_T(
    ACTION=_F(
        INTITULE="REAC_NODA_ENCASTREMENT",
        GROUP_NO="ENCASTR",
        RESULTAT=RESU,
        NOM_CHAM="REAC_NODA",
        RESULTANTE=("DX", "DY", "DZ"),
        MOMENT=("DRX", "DRY", "DRZ"),
        POINT=(0.0, 0.0, 0.0),
        OPERATION="EXTRACTION",
    )
)

IMPR_TABLE(TABLE=T_REAC, UNITE=6, FORMAT_R="E20.12")

T_FORC = POST_RELEVE_T(
    ACTION=_F(
        INTITULE="FORC_NODA_ENCASTREMENT",
        GROUP_NO="ENCASTR",
        RESULTAT=RESU,
        NOM_CHAM="FORC_NODA",
        RESULTANTE=("DX", "DY", "DZ"),
        MOMENT=("DRX", "DRY", "DRZ"),
        POINT=(0.0, 0.0, 0.0),
        OPERATION="EXTRACTION",
    )
)

IMPR_TABLE(TABLE=T_FORC, UNITE=6, FORMAT_R="E20.12")

T_FTOUS = POST_RELEVE_T(
    ACTION=_F(
        INTITULE="FORC_NODA_TOUS",
        GROUP_NO="TOUS",
        RESULTAT=RESU,
        NOM_CHAM="FORC_NODA",
        RESULTANTE=("DX", "DY", "DZ"),
        MOMENT=("DRX", "DRY", "DRZ"),
        POINT=(0.0, 0.0, 0.0),
        OPERATION="EXTRACTION",
    )
)

IMPR_TABLE(TABLE=T_FTOUS, UNITE=6, FORMAT_R="E20.12")

FIN()
