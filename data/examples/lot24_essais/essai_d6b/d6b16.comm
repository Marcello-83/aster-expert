# Essai D6 (lot 24), variante d6b16 -- flexion cylindrique selon T, appuis sur x = 0 et x = a, p = 100.0 Pa, 16 x 16
# Plaque carree DKT 1.0 m x 1.0 m, 16 x 16 quadrangles, EPAIS = 0.01385 m,
# ELAS_COQUE de la decision 2 v5 (SI). L = axe Y du maillage, T = axe X.

DEBUT()

MAIL = LIRE_MAILLAGE(FORMAT="ASTER", UNITE=20)

MO = AFFE_MODELE(
    MAILLAGE=MAIL,
    AFFE=_F(TOUT="OUI", PHENOMENE="MECANIQUE", MODELISATION="DKT"),
)

CARA = AFFE_CARA_ELEM(MODELE=MO, COQUE=_F(GROUP_MA="PLAQUE", EPAIS=0.01385, ANGL_REP=(90.0, 0.0)))

MAT = DEFI_MATERIAU(ELAS_COQUE=_F(MEMB_L=2908000000.0, MEMB_LT=0.0, MEMB_T=81000.0, MEMB_G_LT=526000000.0, FLEX_L=89000000.0, FLEX_LT=0.0, FLEX_T=11300.0, FLEX_G_LT=8400.0, CISA_L=526000000.0, CISA_T=526000000.0, RHO=7850.0))

CHMAT = AFFE_MATERIAU(MAILLAGE=MAIL, AFFE=_F(GROUP_MA="PLAQUE", MATER=MAT))

CHAR = AFFE_CHAR_MECA(
    MODELE=MO,
    DDL_IMPO=(
        _F(GROUP_NO="TOUS", DRZ=0.0),
        _F(GROUP_NO=("NX0", "NXA"), DZ=0.0),
        _F(GROUP_NO="COIN0", DX=0.0, DY=0.0),
        _F(GROUP_NO="COINA", DY=0.0),
    ),
    PRES_REP=_F(GROUP_MA="PLAQUE", PRES=100.0),
)

RESU = MECA_STATIQUE(MODELE=MO, CHAM_MATER=CHMAT, CARA_ELEM=CARA, EXCIT=_F(CHARGE=CHAR))

RESU = CALC_CHAMP(
    reuse=RESU,
    RESULTAT=RESU,
    CONTRAINTE=("EFGE_ELNO", "EFGE_NOEU"),
    FORCE="REAC_NODA",
)

T_DEPL = CREA_TABLE(
    RESU=_F(RESULTAT=RESU, NOM_CHAM="DEPL", NUME_ORDRE=1, NOM_CMP=("DX", "DY", "DZ"), TOUT="OUI")
)

IMPR_TABLE(TABLE=T_DEPL, UNITE=6, FORMAT_R="E20.12")

T_EFGE_ELNO = CREA_TABLE(
    RESU=_F(RESULTAT=RESU, NOM_CHAM="EFGE_ELNO", NUME_ORDRE=1, NOM_CMP=("NXX", "NYY", "NXY", "MXX", "MYY", "MXY", "QX", "QY"), TOUT="OUI")
)

IMPR_TABLE(TABLE=T_EFGE_ELNO, UNITE=6, FORMAT_R="E20.12")

T_EFGE_NOEU = CREA_TABLE(
    RESU=_F(RESULTAT=RESU, NOM_CHAM="EFGE_NOEU", NUME_ORDRE=1, NOM_CMP=("NXX", "NYY", "NXY", "MXX", "MYY", "MXY", "QX", "QY"), TOUT="OUI")
)

IMPR_TABLE(TABLE=T_EFGE_NOEU, UNITE=6, FORMAT_R="E20.12")

T_R_NX0 = POST_RELEVE_T(
    ACTION=_F(
        INTITULE="REAC_NODA_NX0",
        GROUP_NO="NX0",
        RESULTAT=RESU,
        NOM_CHAM="REAC_NODA",
        RESULTANTE=("DX", "DY", "DZ"),
        MOMENT=("DRX", "DRY", "DRZ"),
        POINT=(0.0, 0.0, 0.0),
        OPERATION="EXTRACTION",
    )
)

IMPR_TABLE(TABLE=T_R_NX0, UNITE=6, FORMAT_R="E20.12")

T_R_NXA = POST_RELEVE_T(
    ACTION=_F(
        INTITULE="REAC_NODA_NXA",
        GROUP_NO="NXA",
        RESULTAT=RESU,
        NOM_CHAM="REAC_NODA",
        RESULTANTE=("DX", "DY", "DZ"),
        MOMENT=("DRX", "DRY", "DRZ"),
        POINT=(0.0, 0.0, 0.0),
        OPERATION="EXTRACTION",
    )
)

IMPR_TABLE(TABLE=T_R_NXA, UNITE=6, FORMAT_R="E20.12")

T_R_TOUS = POST_RELEVE_T(
    ACTION=_F(
        INTITULE="REAC_NODA_TOUS",
        GROUP_NO="TOUS",
        RESULTAT=RESU,
        NOM_CHAM="REAC_NODA",
        RESULTANTE=("DX", "DY", "DZ"),
        MOMENT=("DRX", "DRY", "DRZ"),
        POINT=(0.0, 0.0, 0.0),
        OPERATION="EXTRACTION",
    )
)

IMPR_TABLE(TABLE=T_R_TOUS, UNITE=6, FORMAT_R="E20.12")

FIN()
