)
RESU_Q3 = CALC_CHAMP(
    reuse=RESU_Q3, RESULTAT=RESU_Q3, FORCE=("REAC_NODA", "FORC_NODA")
)

TAB_REAC_Q3 = POST_RELEVE_T(
    ACTION=_F(
        OPERATION="EXTRACTION",
        INTITULE="REACTIONS_Q3",
        RESULTAT=RESU_Q3,
        NOM_CHAM="REAC_NODA",
        TOUT_ORDRE="OUI",
        GROUP_NO=("ANCRAGES", "PIED_TUBES", "SYM_G", "SYM_D",),
        RESULTANTE=("DY", "DZ"),
    )
)
IMPR_TABLE(TABLE=TAB_REAC_Q3, UNITE=6)

# Point 7 : symétrie -- deux paires de nœuds symétriques par rapport à
# X = 0 (ancrages et têtes des tubes de bord, puis de leurs voisins
# immédiats) et le nœud BOLLARD, sur l'axe de symétrie lui-même (attendu
# DX ~ 0).
TAB_SYM_Q3 = POST_RELEVE_T(
    ACTION=_F(
        OPERATION="EXTRACTION",
        INTITULE="SYMETRIE_Q3",
        RESULTAT=RESU_Q3,
        NOM_CHAM="DEPL",
        TOUT_ORDRE="OUI",
        GROUP_NO=("ANC_01", "ANC_03", "TETE_TUBE_02", "BOLLARD"),
        NOM_CMP=("DX", "DY", "DZ"),
    )
)
IMPR_TABLE(TABLE=TAB_SYM_Q3, UNITE=6)

TAB_ORDRE_Q3 = POST_RELEVE_T(
    ACTION=_F(
        OPERATION="EXTREMA",
        INTITULE="ORDRE_GRANDEUR_Q3",
        RESULTAT=RESU_Q3,
        NOM_CHAM="DEPL",
        TOUT_ORDRE="OUI",
        GROUP_NO=("TETE_TUBE_01", "TETE_TUBE_02", "TETE_TUBE_03"),
        NOM_CMP="DY",
    )
)
IMPR_TABLE(TABLE=TAB_ORDRE_Q3, UNITE=6)

RESU_A = MECA_STATIQUE(
    MODELE=MO,
    CHAM_MATER=CHMAT,
    CARA_ELEM=CARA,
    EXCIT=(
        _F(CHARGE=CH_SOLIDE),
        _F(CHARGE=CH_BLOC),
        _F(CHARGE=CH_A),
    ),
    SOLVEUR=_F(METHODE="MUMPS", RESI_RELA=0.0001),
)
RESU_A = CALC_CHAMP(
    reuse=RESU_A, RESULTAT=RESU_A, FORCE=("REAC_NODA", "FORC_NODA")
)

TAB_REAC_A = POST_RELEVE_T(
    ACTION=_F(
        OPERATION="EXTRACTION",
        INTITULE="REACTIONS_A",
        RESULTAT=RESU_A,
        NOM_CHAM="REAC_NODA",
        TOUT_ORDRE="OUI",
        GROUP_NO=("ANCRAGES", "PIED_TUBES", "SYM_G", "SYM_D",),
        RESULTANTE=("DY"),
    )
)
IMPR_TABLE(TABLE=TAB_REAC_A, UNITE=6)

# Point 7 : symétrie -- deux paires de nœuds symétriques par rapport à
# X = 0 (ancrages et têtes des tubes de bord, puis de leurs voisins
# immédiats) et le nœud BOLLARD, sur l'axe de symétrie lui-même (attendu
# DX ~ 0).
TAB_SYM_A = POST_RELEVE_T(
    ACTION=_F(
        OPERATION="EXTRACTION",
        INTITULE="SYMETRIE_A",
        RESULTAT=RESU_A,
        NOM_CHAM="DEPL",
        TOUT_ORDRE="OUI",
        GROUP_NO=("ANC_01", "ANC_03", "TETE_TUBE_02", "BOLLARD"),
        NOM_CMP=("DX", "DY", "DZ"),
    )
)
IMPR_TABLE(TABLE=TAB_SYM_A, UNITE=6)

IMPR_RESU(
    FORMAT="MED",
    UNITE=80,
    RESU=(
        _F(RESULTAT=RESU_G),
        _F(RESULTAT=RESU_EAU_P),
        _F(RESULTAT=RESU_EAU_A),
        _F(RESULTAT=RESU_Q1),
        _F(RESULTAT=RESU_Q3),
        _F(RESULTAT=RESU_A),
    ),
)

FIN()
