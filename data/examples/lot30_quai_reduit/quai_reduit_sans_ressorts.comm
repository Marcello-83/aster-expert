    ABSCISSE=(-26.0, -18.001, -17.999, -9.001, -8.999, -2.001, -1.999, 2.0, 4.0),
    ORDONNEE=(66500.0, 35800.0, 80800.0, 42400.0, 41100.0, 21200.0, 24000.0, 11700.0, 0.0),
    INTERPOL="LIN",
