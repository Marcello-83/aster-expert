TAB_REAC_A = POST_RELEVE_T(
    ACTION=_F(
        OPERATION="EXTRACTION",
        INTITULE="REACTIONS_A",
        RESULTAT=RESU_A,
        NOM_CHAM="REAC_NODA",
        TOUT_ORDRE="OUI",
        GROUP_NO=("ANCRAGES", "PIED_TUBES", "SYM_G", "SYM_D",),
        RESULTANTE=("DY"),
    )
)
IMPR_TABLE(TABLE=TAB_REAC_A, UNITE=6)

# Point 7 : symétrie -- deux paires de nœuds symétriques par rapport à
# X = 0 (ancrages et têtes des tubes de bord, puis de leurs voisins
# immédiats) et le nœud BOLLARD, sur l'axe de symétrie lui-même (attendu
# DX ~ 0).
TAB_SYM_A = POST_RELEVE_T(
    ACTION=_F(
        OPERATION="EXTRACTION",
        INTITULE="SYMETRIE_A",
        RESULTAT=RESU_A,
        NOM_CHAM="DEPL",
        TOUT_ORDRE="OUI",
        GROUP_NO=("ANC_01", "ANC_03", "TETE_TUBE_02", "BOLLARD"),
        NOM_CMP=("DX", "DY", "DZ"),
    )
)
IMPR_TABLE(TABLE=TAB_SYM_A, UNITE=6)

IMPR_RESU(
    FORMAT="MED",
    UNITE=80,
    RESU=(
        _F(RESULTAT=RESU_G, CARA_ELEM=CARA, NOM_RESU_MED="G"),
        _F(RESULTAT=RESU_EAU_P, CARA_ELEM=CARA, NOM_RESU_MED="EAU_P"),
        _F(RESULTAT=RESU_EAU_A, CARA_ELEM=CARA, NOM_RESU_MED="EAU_A"),
        _F(RESULTAT=RESU_Q1, CARA_ELEM=CARA, NOM_RESU_MED="Q1"),
        _F(RESULTAT=RESU_Q3, CARA_ELEM=CARA, NOM_RESU_MED="Q3"),
        _F(RESULTAT=RESU_A, CARA_ELEM=CARA, NOM_RESU_MED="A"),
    ),
)

FIN()
