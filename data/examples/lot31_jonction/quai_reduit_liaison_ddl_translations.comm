# Point 7 : symétrie par rapport aux plans X = constante (SYM_G, SYM_D) --
# translation normale au plan (DX) et rotations autour des deux axes du plan
# (DRY, DRZ) sur sa part hors anneau de tête seulement quand la jonction est
# LIAISON_SOLIDE (voir le commentaire de symmetry_and_support_block : la part
# de l'anneau tient alors ses six degrés de liberté de LIAISON_SOLIDE, les
# imposer une seconde fois y a produit un pivot nul -- lot 32, généralisé aux
# translations après le lot 31 qui n'excluait que les rotations), sur le plan
# entier sinon (candidats C1/C4, lot 31) ; DY, DZ, DRX libres (U4.44.01,
# tableau 5-2 : degrés de liberté dans le repère global ; cas test
# ssls100b.comm, bords de symétrie).
# Point 11 (décision 12) : appui vertical seul au pied des tubes.
# Point 2 : extrémité arrière du tirant bloquée (ANCRAGES) -- donnée du
# modèle (tirants.longueur_modelisee : "extrémité arrière bloquée"),
# BARRE n'ayant pas de degré de rotation à bloquer.
CH_BLOC = AFFE_CHAR_MECA(
    MODELE=MO,
    DDL_IMPO=(
        _F(GROUP_NO=("SYM_G",), DX=0.0, DRY=0.0, DRZ=0.0),
        _F(GROUP_NO=("SYM_D",), DX=0.0, DRY=0.0, DRZ=0.0),
        _F(GROUP_NO=("PIED_TUBES",), DZ=0.0),
        _F(GROUP_NO=("ANCRAGES",), DX=0.0, DY=0.0, DZ=0.0),
    ),
)

F_G = DEFI_FONCTION(
    NOM_PARA="Z",
    ABSCISSE=(-26.0, -18.001, -17.999, -9.001, -8.999, -2.001, -1.999, 2.0, 4.0),
    ORDONNEE=(66500.0, 35800.0, 80800.0, 42400.0, 41100.0, 21200.0, 24000.0, 11700.0, 0.0),
    INTERPOL="LIN",
    PROL_DROITE="CONSTANT",
    PROL_GAUCHE="CONSTANT",
)

F_Q1 = DEFI_FONCTION(
    NOM_PARA="Z",
    ABSCISSE=(-26.0, -18.001, -17.999, -9.001, -8.999, -2.001, -1.999, 2.0, 4.0),
    ORDONNEE=(13300.0, 13300.0, 16200.0, 16200.0, 10800.0, 10800.0, 12300.0, 12300.0, 12300.0),
    INTERPOL="LIN",
    PROL_DROITE="CONSTANT",
    PROL_GAUCHE="CONSTANT",
)

F_EAU_P = DEFI_FONCTION(
    NOM_PARA="Z",
    ABSCISSE=(0.5, 2.0),
    ORDONNEE=(15000.0, 0.0),
    INTERPOL="LIN",
    PROL_DROITE="CONSTANT",
    PROL_GAUCHE="CONSTANT",
)

F_EAU_A = DEFI_FONCTION(
    NOM_PARA="Z",
    ABSCISSE=(-0.5, 3.0),
    ORDONNEE=(35000.0, 0.0),
    INTERPOL="LIN",
    PROL_DROITE="CONSTANT",
    PROL_GAUCHE="CONSTANT",
)

CH_G_POUSSEE = AFFE_CHAR_MECA_F(
    MODELE=MO, FORCE_COQUE=_F(GROUP_MA=("ECRAN_POUSSEE",), PRES=F_G)
)

CH_G_POIDS = AFFE_CHAR_MECA(
    MODELE=MO,
    PESANTEUR=_F(GRAVITE=9.81, DIRECTION=(0.0, 0.0, -1.0), GROUP_MA=("TUBES", "PALPS", "TIRANTS",)),
)

CH_Q1 = AFFE_CHAR_MECA_F(
    MODELE=MO, FORCE_COQUE=_F(GROUP_MA=("ECRAN_POUSSEE",), PRES=F_Q1)
)

CH_EAU_P = AFFE_CHAR_MECA_F(
    MODELE=MO, FORCE_COQUE=_F(GROUP_MA=("ECRAN_POUSSEE",), PRES=F_EAU_P)
)

CH_EAU_A = AFFE_CHAR_MECA_F(
    MODELE=MO, FORCE_COQUE=_F(GROUP_MA=("ECRAN_POUSSEE",), PRES=F_EAU_A)
)

# Point 8 (cas Q3) : force et moment de transport sur BOLLARD (U4.44.01,
# FORCE_NODALE, repère global). FY : composante horizontale (donnée, non
# recalculée), vers le bassin (-Y). FZ : composante verticale, déduite de
# l'intensité et de l'inclinaison (amarrage_effort x sin(inclinaison)),
# calcul commenté ici, non typé en dur. MX : moment de transport (donné, non
# recalculé), d'axe parallèle au quai.
CH_Q3 = AFFE_CHAR_MECA(
    MODELE=MO,
    FORCE_NODALE=_F(GROUP_NO=("BOLLARD",), FY=-866000.0, FZ=499999.99999999994, MX=606000.0),
)

# Point 8 (cas A) : effort d'accostage sur DEFENSE, direction globale +Y
# (perpendiculaire au quai, vers la terre -- décision point 8), intensité
# rapportée à la surface développée des mailles de DEFENSE (essai lot 21,
# point 8 : la référence de FORCE_COQUE est la surface développée, non la
# surface projetée), FX = FZ = 0.
CH_A = AFFE_CHAR_MECA(
    MODELE=MO, FORCE_COQUE=_F(GROUP_MA=("DEFENSE",), FY=718056.0475032325)
)

# Point 12 (décision 13) : FY = -intégrale(p dz) (linéique, vers le bassin,
# comme la poussée sur l'écran), MX = intégrale(p*(z - 3,30) dz) (moment
# linéique de transport de la résultante à l'axe de la poutre). FZ (cas G
# seul) : poids propre de la poutre (lot 33, étape 3 -- voir pesanteur_block).
