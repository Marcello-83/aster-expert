# Essai B (lot 22), variante b2 -- plaque 2 en ELAS_COQUE avec RHO.
# Plaque 1 : ELAS + RHO = 7850.0 (temoin). Plaque 2 : ELAS_COQUE,
# EPAIS = 0.02
# (differente de la plaque 1 pour distinguer masse surfacique et masse volumique).
# PESANTEUR sur tout le modele ; resultante verticale des reactions par plaque.

DEBUT()

MAIL = LIRE_MAILLAGE(FORMAT="ASTER", UNITE=20)

MO = AFFE_MODELE(
    MAILLAGE=MAIL,
    AFFE=_F(TOUT="OUI", PHENOMENE="MECANIQUE", MODELISATION="DKT"),
)

CARA = AFFE_CARA_ELEM(
    MODELE=MO,
    COQUE=(
        _F(GROUP_MA="P1", EPAIS=0.01),
        _F(GROUP_MA="P2", EPAIS=0.02),
    ),
)

MAT1 = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.3, RHO=7850.0))

MAT2 = DEFI_MATERIAU(ELAS_COQUE=_F(MEMB_L=4615384615.384615, MEMB_LT=1384615384.6153843, MEMB_T=4615384615.384615, MEMB_G_LT=1615384615.3846152, FLEX_L=153846.15384615387, FLEX_LT=46153.84615384616, FLEX_T=153846.15384615387, FLEX_G_LT=53846.15384615385, CISA_L=1346153846.153846, CISA_T=1346153846.153846, RHO=100.0))

CHMAT = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(_F(GROUP_MA="P1", MATER=MAT1), _F(GROUP_MA="P2", MATER=MAT2)),
)

# Par plaque : A DX, DY, DZ ; B DY, DZ ; les deux autres coins DZ.
CHAR = AFFE_CHAR_MECA(
    MODELE=MO,
    DDL_IMPO=(
        _F(GROUP_NO=("A1", "A2"), DX=0.0, DY=0.0, DZ=0.0),
        _F(GROUP_NO=("B1", "B2"), DY=0.0, DZ=0.0),
        _F(GROUP_NO=("APP1", "APP2"), DZ=0.0),
    ),
    PESANTEUR=_F(GRAVITE=9.81, DIRECTION=(0.0, 0.0, -1.0)),
)

RESU = MECA_STATIQUE(MODELE=MO, CHAM_MATER=CHMAT, CARA_ELEM=CARA, EXCIT=_F(CHARGE=CHAR))

RESU = CALC_CHAMP(reuse=RESU, RESULTAT=RESU, FORCE="REAC_NODA")

TAB1 = POST_RELEVE_T(
    ACTION=_F(
        INTITULE="RESULTANTE_PLAQUE_1",
        GROUP_NO="APP1",
        RESULTAT=RESU,
        NOM_CHAM="REAC_NODA",
        RESULTANTE=("DX", "DY", "DZ"),
        OPERATION="EXTRACTION",
    )
)

TAB2 = POST_RELEVE_T(
    ACTION=_F(
        INTITULE="RESULTANTE_PLAQUE_2",
        GROUP_NO="APP2",
        RESULTAT=RESU,
        NOM_CHAM="REAC_NODA",
        RESULTANTE=("DX", "DY", "DZ"),
        OPERATION="EXTRACTION",
    )
)

IMPR_TABLE(TABLE=TAB1, UNITE=6, FORMAT_R="E20.12")

IMPR_TABLE(TABLE=TAB2, UNITE=6, FORMAT_R="E20.12")

FIN()
