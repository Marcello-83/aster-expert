# Dépôts Code_Aster clonés : jamais versionnés dans ce dépôt.
/external/*
!/external/.gitkeep

# Données produites.
/data/raw/*
/data/processed/*
/data/indexes/*
!/data/raw/.gitkeep
!/data/processed/.gitkeep
!/data/indexes/.gitkeep

# Le jeu d'évaluation est versionné : il fait partie des sources du projet.
!/data/evaluations/
!/data/evaluations/**

# Environnement.
.env
.venv/
venv/

# Python.
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Sorties Code_Aster éventuellement déposées à la racine.
*.mess
*.resu
*.rmed
*.base
fort.*
/proc.*/

# Éditeurs et système.
.vscode/
.idea/
*.swp
.DS_Store

# Lot 36 : MED volumineux du dossier de résultats pour ParaVis (jamais versionnés).
/résultats_MED_Paravis/*.med

# Lot 41 : sorties des étapes d'un projet (`aster-expert projet <nom> <étape>`),
# reproductibles ; les résultats de référence vivent dans projets/<nom>/references/.
/projets/*/resultats/

# Lot 41 ter : réglages locaux de Claude Code (jusqu'ici ignorés par le seul
# fichier d'exclusion global de la VM).
.claude/settings.local.json
.claude/scheduled_tasks.lock
