# Copier en .env et renseigner. Ce fichier ne contient jamais de secret réel.

# --- Environnement Code_Aster -------------------------------------------
# Script d'environnement à sourcer avant toute invocation d'Aster.
# Chemin à confirmer sur l'installation réelle, aucune valeur par défaut
# ne doit être supposée correcte.
ASTER_ENV_SCRIPT=

# Binaire run_aster. Laisser vide pour recherche dans le PATH après
# chargement de ASTER_ENV_SCRIPT.
RUN_ASTER_BIN=

# Interpréteur Python de l'installation Code_Aster, seul capable d'importer
# `code_aster`. Distinct du Python du projet. Renseigné automatiquement par
# `aster-expert env detect` s'il est laissé vide.
ASTER_PYTHON=

# --- Exécution -----------------------------------------------------------
ASTER_RUN_TIMEOUT=1800
ASTER_RUN_MEMORY_MB=8192
ASTER_RUN_MPI=1

# Racines depuis lesquelles un fichier .comm peut être exécuté.
# Liste séparée par des deux-points. Vide = aucune exécution autorisée.
ASTER_ALLOWED_ROOTS=

# --- Projet --------------------------------------------------------------
ASTER_EXPERT_ROOT=
ASTER_EXPERT_LOG_LEVEL=INFO

# --- Hors périmètre v1 ---------------------------------------------------
# Aucun appel à une API de modèle n'est effectué par ce dépôt en v1.
# ANTHROPIC_API_KEY=
