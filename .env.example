# Copier en .env et renseigner. Ce fichier ne contient jamais de secret réel.

# --- Exécution conteneurisée (Docker, image gérée par `cave`) -----------
# Code_Aster n'est pas installé nativement sur cette machine : il s'exécute
# dans une image Docker (`simvia/code_aster`). `cave` gère le téléchargement
# des images mais n'expose aucune commande d'exécution arbitraire ; aster-
# expert invoque `docker` directement. Voir docs/architecture.md, ADR-002,
# ADR-003 et ADR-006.

# Binaire docker. Laisser vide pour recherche dans le PATH.
ASTER_DOCKER_BIN=

# Dépôt de l'image. Ne pas changer sans vérifier que l'image expose la même
# structure (Cata, run_aster) : voir docs/architecture.md, ADR-002.
ASTER_IMAGE_REPOSITORY=simvia/code_aster

# Référence d'image à utiliser : un tag exact (ex. 17.4.0) ou, préférable,
# un digest (sha256:...), combiné automatiquement avec ASTER_IMAGE_REPOSITORY.
# La valeur "stable" est interdite : ce tag est mobile côté registre et a été
# observé divergent de l'image locale du même nom (constaté en session :
# `docker images` donnait `stable` identique à 16.8.0 alors que `cave
# available` annonçait 17.4.0 comme version stable sur Docker Hub, le même
# jour).
# Laisser vide : `aster-expert env detect` retombe alors sur le pin `cave`
# (`.cave` local, puis `~/.cave` global), et échoue explicitement si aucun
# des deux n'existe ou si le pin lui-même est symbolique ("stable"/"testing").
# Le tag et le digest résolus sont écrits dans config/versions.yaml, section
# `detected`.
ASTER_IMAGE_REF=

# Isolation du conteneur (voir ADR-006). Aucune valeur par défaut risquée :
# une exécution sans limite explicite est refusée.
ASTER_CONTAINER_NETWORK=none
ASTER_CONTAINER_MEMORY=8g
ASTER_CONTAINER_CPUS=2

# Répertoire racine sous lequel un répertoire de travail dédié (temporaire ou
# explicite) peut être monté dans le conteneur. Jamais $HOME, jamais la
# racine de ce dépôt. Vide = aucune introspection ni exécution autorisée.
ASTER_CONTAINER_WORKROOT=

# Délai maximal enveloppant l'appel `docker run` lui-même (secondes).
ASTER_RUN_TIMEOUT=1800

# --- Projet --------------------------------------------------------------
ASTER_EXPERT_ROOT=
ASTER_EXPERT_LOG_LEVEL=INFO

# --- Hors périmètre v1 ---------------------------------------------------
# Aucun appel à une API de modèle n'est effectué par ce dépôt en v1.
# ANTHROPIC_API_KEY=
