DEBUT()
MA = LIRE_MAILLAGE(FORMAT="MED")
MO = AFFE_MODELE(MAILLAGE=MA, AFFE=_F(TOUT="OUI", PHENOMENE="MECANIQUE", MODELISATION="DKT"))
CL = AFFE_CHAR_MECA(MODELE=MO, DDL_IMPO=_F(GROUP_NO="A", DX=0.0))
CH = AFFE_CHAR_MECA(MODELE=MO, FORCE_NODALE=_F(GROUP_NO="B", FZ=1.0))
R = MACRO_ELAS_MULT(MODELE=MO, CHAR_MECA_GLOBAL=(CL,), CAS_CHARGE=_F(NOM_CAS="C1", CHAR_MECA=CH))
R = CALC_CHAMP(reuse=R, RESULTAT=R, FORCE="REAC_NODA", MOT_INEXISTANT=1)
FIN()
